:root {
  --bg: #070a0f;
  --surface: #10151d;
  --surface-2: #151b25;
  --line: rgba(255,255,255,.08);
  --text: #f5f7fb;
  --muted: #8d97a8;
  --accent: #19d66b;
  --accent-2: #8b5cf6;
  --danger: #ff4d67;
  --gold: #f4c95d;
}

* { box-sizing: border-box; }
button, input { font: inherit; }
button { -webkit-tap-highlight-color: transparent; }

.batzo-app {
  min-height: 100vh;
  color: var(--text);
  background:
    radial-gradient(circle at 80% 0%, rgba(139,92,246,.14), transparent 30%),
    radial-gradient(circle at 0% 30%, rgba(25,214,107,.08), transparent 28%),
    var(--bg);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  padding-bottom: 88px;
}

.topbar {
  height: 74px;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(7,10,15,.88);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--line);
}

.brand-wrap, .top-actions, .teams, .match-top, .match-bottom, .section-head, .contest-card, .trust-strip {
  display: flex;
  align-items: center;
}

.brand-wrap { gap: 10px; }
.brand-mark {
  width: 40px; height: 40px; border-radius: 13px;
  display: grid; place-items: center;
  font-size: 22px; font-weight: 950;
  color: #06100a;
  background: linear-gradient(145deg, #7affb1, var(--accent));
  box-shadow: 0 8px 24px rgba(25,214,107,.18);
}
.brand { font-size: 18px; font-weight: 950; letter-spacing: 2px; line-height: 1; }
.brand-sub { font-size: 7px; color: var(--muted); letter-spacing: 2.4px; margin-top: 5px; }

.top-actions { gap: 8px; }
.icon-btn, .wallet-btn {
  border: 1px solid var(--line);
  color: var(--text);
  background: rgba(255,255,255,.04);
  border-radius: 12px;
}
.icon-btn { width: 42px; height: 42px; font-size: 20px; }
.wallet-btn { min-width: 78px; padding: 7px 10px; text-align: left; }
.wallet-btn span { display:block; color:var(--muted); font-size:9px; }
.wallet-btn b { font-size:12px; }

.content { max-width: 680px; margin: 0 auto; padding: 16px; }

.hero {
  min-height: 235px; position: relative; overflow: hidden;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 24px; padding: 24px;
  background:
    linear-gradient(135deg, rgba(25,214,107,.18), transparent 45%),
    linear-gradient(145deg, #161d27, #0d1118);
  box-shadow: 0 20px 50px rgba(0,0,0,.25);
}
.hero-glow {
  position:absolute; width:180px; height:180px; border-radius:50%;
  right:-60px; top:-60px;
  background: radial-gradient(circle, rgba(139,92,246,.35), transparent 68%);
}
.hero-copy { position:relative; z-index:2; max-width: 78%; }
.eyebrow, .section-kicker, .contest-label {
  display:block; font-size:9px; font-weight:850; letter-spacing:1.7px; color:var(--accent);
}
.hero h1 { margin:9px 0; font-size:34px; line-height:1.02; letter-spacing:-1.5px; }
.hero h1 em { color:var(--accent); font-style:normal; }
.hero p { color:var(--muted); font-size:12px; line-height:1.5; max-width:340px; }
.hero-ball {
  position:absolute; right:18px; bottom:14px;
  font-size:78px; filter: drop-shadow(0 15px 25px rgba(0,0,0,.35));
  transform: rotate(-12deg);
}

.primary-btn, .secondary-btn {
  border:0; border-radius:12px; padding:12px 15px; font-weight:900; font-size:11px;
}
.primary-btn { color:#06100a; background:linear-gradient(135deg,#77ffae,var(--accent)); }
.primary-btn span { margin-left:10px; }
.secondary-btn { color:var(--text); background:var(--surface-2); border:1px solid var(--line); }

.quick-grid {
  display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin:12px 0 22px;
}
.quick-grid button {
  min-height:88px; border:1px solid var(--line); border-radius:15px;
  background:rgba(255,255,255,.035); color:var(--text); text-align:left; padding:11px;
}
.quick-grid span { display:block; font-size:20px; margin-bottom:7px; }
.quick-grid b { display:block; font-size:10px; }
.quick-grid small { display:block; color:var(--muted); font-size:8px; margin-top:4px; }

.section { margin-top:24px; }
.section-head { justify-content:space-between; margin-bottom:10px; }
.section-head h2 { margin:4px 0 0; font-size:20px; letter-spacing:-.4px; }
.section-head button { border:0; background:none; color:var(--accent); font-size:10px; font-weight:800; }

.match-list, .contest-list { display:grid; gap:10px; }

.match-card {
  width:100%; text-align:left; color:var(--text);
  border:1px solid var(--line); border-radius:17px;
  background:linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.025));
  padding:14px; box-shadow:0 8px 25px rgba(0,0,0,.14);
}
.match-card:active, .contest-card:active, .quick-grid button:active { transform:scale(.985); }
.match-top, .match-bottom { justify-content:space-between; }
.match-top { color:var(--muted); font-size:9px; font-weight:800; }
.live-dot { color:var(--danger); }
.teams { justify-content:space-between; gap:10px; margin:16px 0 12px; }
.team { flex:1; display:grid; grid-template-columns:34px 1fr; column-gap:8px; align-items:center; }
.team strong { font-size:11px; }
.team b { grid-column:2; color:var(--accent); font-size:12px; margin-top:3px; }
.team-badge {
  width:34px; height:34px; border-radius:10px; display:grid; place-items:center;
  background:linear-gradient(145deg,#252e3b,#11161e);
  border:1px solid var(--line); font-size:9px; font-weight:950;
}
.vs { color:#566072; font-size:9px; font-weight:900; }
.match-bottom { padding-top:10px; border-top:1px solid var(--line); color:var(--muted); font-size:9px; }
.join-live { color:var(--accent); font-weight:900; }

.contest-card {
  width:100%; gap:12px; justify-content:space-between;
  padding:14px; border-radius:15px; border:1px solid var(--line);
  background:var(--surface); color:var(--text); text-align:left;
}
.contest-card strong { display:block; color:var(--gold); font-size:18px; margin-top:3px; }
.contest-mid { flex:1; }
.contest-mid b { display:block; font-size:11px; }
.contest-mid span { display:block; color:var(--muted); font-size:9px; margin-top:4px; }
.entry { border-radius:10px; background:rgba(25,214,107,.08); padding:7px 10px; text-align:center; }
.entry span { display:block; color:var(--accent); font-size:7px; font-weight:900; }
.entry b { font-size:12px; }

.trust-strip {
  gap:10px; padding:15px; margin-top:18px;
  border:1px solid var(--line); border-radius:15px; background:rgba(255,255,255,.025);
}
.trust-strip > span { width:30px; height:30px; display:grid; place-items:center; border-radius:50%; background:rgba(25,214,107,.1); color:var(--accent); }
.trust-strip b { display:block; font-size:10px; }
.trust-strip small { display:block; color:var(--muted); font-size:8px; margin-top:3px; }

.notice {
  width:100%; margin-bottom:10px; padding:10px 12px;
  border:1px solid rgba(25,214,107,.2); border-radius:11px;
  background:rgba(25,214,107,.07); color:var(--text);
  display:flex; justify-content:space-between; font-size:10px;
}
.notice b { color:var(--accent); }

.page { padding-top:10px; }
.page-title { margin:12px 2px 18px; }
.page-title h1 { margin:5px 0; font-size:30px; letter-spacing:-1px; }
.page-title p { color:var(--muted); font-size:12px; }
.search-box {
  display:flex; align-items:center; gap:8px; padding:11px 13px;
  border:1px solid var(--line); border-radius:13px; background:var(--surface); margin-bottom:18px;
}
.search-box span { color:var(--muted); font-size:18px; }
.search-box input { flex:1; border:0; outline:0; background:none; color:var(--text); font-size:11px; }
.list-title { margin:18px 2px 9px; color:var(--muted); font-size:9px; letter-spacing:1.5px; }
.empty-card { margin-top:12px; padding:25px; text-align:center; color:var(--muted); border:1px dashed var(--line); border-radius:15px; font-size:11px; }
.centered-page { min-height:65vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; }
.centered-page h1 { margin:8px 0; }
.centered-page p { max-width:320px; color:var(--muted); font-size:12px; line-height:1.6; }
.big-icon, .profile-avatar { margin-bottom:15px; }
.big-icon { font-size:55px; }
.profile-avatar { width:70px; height:70px; display:grid; place-items:center; border-radius:22px; background:linear-gradient(145deg,#77ffae,var(--accent)); color:#06100a; font-size:35px; font-weight:950; }

.bottom-nav {
  position:fixed; left:50%; bottom:10px; transform:translateX(-50%);
  width:min(calc(100% - 20px), 650px); z-index:30;
  display:grid; grid-template-columns:repeat(5,1fr);
  padding:7px; border:1px solid var(--line); border-radius:18px;
  background:rgba(13,17,24,.92); backdrop-filter:blur(18px);
  box-shadow:0 15px 45px rgba(0,0,0,.4);
}
.bottom-nav button {
  border:0; background:none; color:#727d8f; border-radius:13px; padding:7px 2px;
}
.bottom-nav button span { display:block; font-size:16px; height:20px; }
.bottom-nav button small { font-size:7px; font-weight:850; }
.bottom-nav button.active { color:var(--accent); background:rgba(25,214,107,.08); }

@media (max-width:430px) {
  .content { padding:12px; }
  .hero { min-height:225px; padding:20px; }
  .hero h1 { font-size:30px; }
  .hero-ball { font-size:62px; right:7px; }
  .quick-grid { gap:6px; }
  .quick-grid button { padding:9px 7px; }
  .quick-grid b { font-size:9px; }
  .quick-grid small { font-size:7px; }
}

@media (min-width:700px) {
  .batzo-app { border-left:1px solid var(--line); border-right:1px solid var(--line); max-width:720px; margin:auto; }
}

/* =========================================================
   BATZO PREMIUM 3D MULTI-COLOUR WORDMARK
   ========================================================= */

.brand-wrap {
  align-items: center;
  gap: 8px;
  min-height: 64px;
  overflow: visible;
}

.brand-logo-3d {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: 7px;
  padding: 2px 0 5px;
  font-size: 29px;
  line-height: .9;
  font-weight: 1000;
  letter-spacing: -2.2px;
  white-space: nowrap;
  transform: perspective(420px) rotateX(4deg);
  filter:
    drop-shadow(0 5px 7px rgba(0,0,0,.65))
    drop-shadow(0 0 12px rgba(25,214,107,.12));
}

.brand-logo-3d span {
  display: inline-block;
  position: relative;
  -webkit-text-stroke: 1px rgba(255,255,255,.22);
  text-shadow:
    1px 1px 0 rgba(0,0,0,.85),
    2px 2px 0 rgba(0,0,0,.65),
    3px 3px 0 rgba(0,0,0,.45),
    0 0 9px rgba(255,255,255,.12);
}

/* Multi-colour 3D letters */
.logo-b {
  background: linear-gradient(145deg,#b8ff62 0%,#24ff76 28%,#00d9ff 62%,#2475ff 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.logo-a {
  background: linear-gradient(145deg,#fff06a 0%,#ffb300 30%,#ff5a00 70%,#ff244f 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.logo-t {
  background: linear-gradient(145deg,#ff5f9e 0%,#ff1f8f 35%,#b829ff 68%,#6f4cff 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.logo-z {
  background: linear-gradient(145deg,#ff54df 0%,#9b5cff 35%,#246bff 70%,#00c8ff 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.logo-o {
  background: linear-gradient(145deg,#5effcf 0%,#00e5a0 35%,#00b8ff 70%,#3778ff 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.brand-sub-wrap {
  align-self: flex-end;
  margin-bottom: 5px;
}

.brand-sub-wrap .brand-sub {
  font-size: 7px;
  font-weight: 850;
  color: #66ffad;
  letter-spacing: 2.4px;
  text-shadow: 0 0 8px rgba(25,214,107,.35);
}

@media (max-width:430px) {
  .topbar {
    height: 82px;
    padding: 9px 12px;
  }

  .brand-wrap {
    min-height: 70px;
    gap: 7px;
  }

  .brand-logo-3d {
    margin-top: 9px;
    font-size: 31px;
    letter-spacing: -2.5px;
  }

  .brand-sub-wrap {
    margin-bottom: 7px;
  }

  .brand-sub-wrap .brand-sub {
    font-size: 6.5px;
    letter-spacing: 2px;
  }

  .top-actions {
    gap: 6px;
  }

  .icon-btn {
    width: 39px;
    height: 39px;
  }

  .wallet-btn {
    min-width: 72px;
  }
}


/* BATZO-3D-REFERENCE-STYLE */

.batzo-app{
  background:
    radial-gradient(circle at 82% 4%,rgba(100,55,190,.13),transparent 28%),
    radial-gradient(circle at 5% 35%,rgba(0,160,130,.035),transparent 25%),
    #05070b;
}

.topbar{
  height:108px;
  padding:10px 16px 7px;
  align-items:flex-end;
  background:rgba(4,6,10,.95);
}

.premium-brand{
  min-width:230px;
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:0;
  padding-bottom:2px;
}

.brand-logo-3d{
  display:inline-block;
  font-size:clamp(46px,12vw,72px);
  line-height:.82;
  font-weight:1000;
  font-style:italic;
  letter-spacing:-5px;
  transform:skewX(-8deg);
  color:transparent;
  background:linear-gradient(
    105deg,
    #62ff39 0%,
    #e7ff22 11%,
    #ff9d00 23%,
    #ff3030 36%,
    #ff159f 50%,
    #9b38ff 65%,
    #247cff 80%,
    #00dfff 100%
  );
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
  text-shadow:
    2px 3px 0 #123126,
    4px 6px 0 #111a2b,
    6px 9px 0 rgba(0,0,0,.75),
    0 0 16px rgba(0,190,255,.16);
  filter:drop-shadow(0 7px 8px rgba(0,0,0,.7));
}

.brand-logo-3d::after{
  content:"";
  display:block;
  height:4px;
  margin-top:8px;
  width:100%;
  border-radius:999px;
  background:linear-gradient(
    90deg,
    #28ff50,#ffe600,#ff4b00,#ff1ea9,#7138ff,#00d5ff
  );
  opacity:.8;
}

.premium-brand .brand-sub{
  margin:8px 0 0 52px;
  font-size:9px;
  font-weight:900;
  letter-spacing:3.5px;
  color:#d2a8df;
}

.hero{
  min-height:300px;
  border-color:rgba(170,50,255,.32);
  background:
    radial-gradient(circle at 83% 35%,rgba(100,50,190,.28),transparent 34%),
    radial-gradient(circle at 65% 90%,rgba(255,20,120,.08),transparent 30%),
    linear-gradient(120deg,#0b171b,#0a1018 45%,#090a12);
}

.hero h1{
  font-size:clamp(40px,10vw,58px);
  line-height:.98;
  font-weight:950;
  letter-spacing:-2.5px;
}

.hero h1 em{
  background:linear-gradient(
    90deg,
    #1bdd61,#a9e629,#ff9100,#ff294d,#f12bb9,#7d45ff,#26d9ff
  );
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
}

.hero p{
  font-size:14px;
  color:#a8afbd;
}

.primary-btn{
  background:linear-gradient(
    100deg,
    #25e875,#a8e62a,#ff9a18,#ff398b,#598dff
  );
  box-shadow:0 10px 28px rgba(255,50,150,.12);
}

.section-kicker{
  color:#d23cff;
}

.section-head button,
.join-live{
  color:#df42ff;
}

.quick-grid button{
  background:linear-gradient(
    145deg,
    rgba(255,255,255,.045),
    rgba(255,255,255,.018)
  );
  border-color:rgba(255,255,255,.11);
}

.match-card,
.contest-card{
  border-color:rgba(255,255,255,.11);
}

.entry{
  background:rgba(220,55,255,.07);
}

.entry span{
  color:#df42ff;
}

.bottom-nav button.active{
  color:#ff43b5;
  background:rgba(255,45,175,.07);
}

@media(max-width:430px){
  .topbar{
    height:102px;
    padding:9px 12px 6px;
  }

  .premium-brand{
    min-width:210px;
  }

  .brand-logo-3d{
    font-size:46px;
    letter-spacing:-4px;
  }

  .premium-brand .brand-sub{
    margin-left:52px;
    font-size:8px;
    letter-spacing:3px;
  }

  .hero{
    min-height:285px;
    padding:22px 18px;
  }

  .hero h1{
    font-size:39px;
  }
}
