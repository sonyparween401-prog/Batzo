* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #101828;
  background: #f5f7fb;
}

body {
  margin: 0;
  min-width: 320px;
  background: #f5f7fb;
}

button {
  font: inherit;
}

button:active {
  transform: scale(0.98);
}

.batzo-app {
  min-height: 100vh;
  padding-bottom: 82px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid #e7eaf0;
  backdrop-filter: blur(12px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: #111827;
  color: white;
  font-size: 22px;
  font-weight: 900;
}

.brand-name {
  font-size: 19px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.brand-subtitle {
  margin-top: 4px;
  color: #667085;
  font-size: 11px;
}

.profile-button {
  width: 42px;
  height: 42px;
  border: 1px solid #e5e7eb;
  border-radius: 50%;
  background: #fff;
  cursor: pointer;
  font-size: 18px;
}

.content {
  width: min(100%, 900px);
  margin: 0 auto;
  padding: 18px;
}

.hero {
  overflow: hidden;
  position: relative;
  min-height: 245px;
  display: flex;
  align-items: center;
  border-radius: 26px;
  padding: 28px;
  background: linear-gradient(135deg, #111827 0%, #273449 100%);
  color: white;
  box-shadow: 0 16px 40px rgba(16, 24, 40, 0.18);
}

.hero::after {
  content: "🏏";
  position: absolute;
  right: 18px;
  bottom: -22px;
  font-size: 150px;
  opacity: 0.08;
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 620px;
}

.hero-badge {
  display: inline-block;
  margin-bottom: 12px;
  padding: 6px 10px;
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  font-size: 11px;
  font-weight: 800;
}

.hero h1 {
  margin: 0;
  font-size: clamp(30px, 7vw, 48px);
  line-height: 1.05;
}

.hero p {
  max-width: 560px;
  margin: 12px 0 20px;
  color: #d0d5dd;
  line-height: 1.6;
  font-size: 14px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.primary-button,
.secondary-button,
.small-button,
.text-button {
  border: 0;
  cursor: pointer;
  font-weight: 800;
}

.primary-button {
  padding: 12px 17px;
  border-radius: 12px;
  background: #fff;
  color: #111827;
}

.secondary-button {
  padding: 12px 17px;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 12px;
  background: rgba(255,255,255,0.08);
  color: white;
}

.section {
  margin-top: 28px;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 13px;
}

.eyebrow {
  color: #667085;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.4px;
}

.section-heading h2,
.page-section h1 {
  margin: 4px 0 0;
}

.text-button {
  background: transparent;
  color: #344054;
  font-size: 13px;
}

.match-list {
  display: grid;
  gap: 13px;
}

.match-card {
  padding: 16px;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  background: white;
  box-shadow: 0 6px 20px rgba(16, 24, 40, 0.05);
}

.match-top,
.match-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.match-top {
  margin-bottom: 18px;
}

.status {
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .6px;
}

.status.live {
  background: #fee4e2;
  color: #b42318;
}

.status.upcoming {
  background: #eef4ff;
  color: #3538cd;
}

.league {
  color: #667085;
  font-size: 11px;
  font-weight: 700;
}

.teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 10px;
}

.team {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  text-align: center;
}

.team-logo {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: #f2f4f7;
  color: #344054;
  font-size: 12px;
  font-weight: 900;
}

.team strong {
  font-size: 13px;
}

.team span {
  color: #667085;
  font-size: 12px;
  font-weight: 800;
}

.vs {
  color: #98a2b3;
  font-size: 10px;
  font-weight: 900;
}

.match-bottom {
  margin-top: 18px;
  padding-top: 13px;
  border-top: 1px solid #f0f2f5;
  color: #667085;
  font-size: 11px;
}

.small-button {
  padding: 8px 12px;
  border-radius: 9px;
  background: #101828;
  color: white;
  font-size: 11px;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-top: 18px;
}

.quick-card {
  min-height: 115px;
  padding: 16px;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  background: white;
  text-align: left;
  cursor: pointer;
  box-shadow: 0 5px 16px rgba(16, 24, 40, 0.04);
}

.quick-card:hover {
  border-color: #cfd4dc;
}

.quick-icon {
  display: block;
  margin-bottom: 12px;
  font-size: 24px;
}

.quick-card strong,
.quick-card small {
  display: block;
}

.quick-card strong {
  font-size: 14px;
}

.quick-card small {
  margin-top: 4px;
  color: #667085;
  font-size: 11px;
}

.page-section {
  padding: 12px 0 30px;
}

.page-section h1 {
  font-size: 32px;
}

.page-description {
  color: #667085;
  line-height: 1.6;
}

.placeholder-card,
.profile-card {
  margin-top: 22px;
  padding: 24px;
  border: 1px solid #e5e7eb;
  border-radius: 22px;
  background: white;
  box-shadow: 0 6px 20px rgba(16, 24, 40, 0.05);
}

.placeholder-card {
  text-align: center;
}

.placeholder-icon {
  font-size: 46px;
}

.placeholder-card h2 {
  margin-bottom: 8px;
}

.placeholder-card p {
  color: #667085;
  line-height: 1.6;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 16px;
}

.large-avatar {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  border-radius: 20px;
  background: #f2f4f7;
  font-size: 28px;
}

.profile-card h2 {
  margin: 0;
}

.profile-card p {
  margin: 5px 0 0;
  color: #667085;
}

.full-button {
  margin-top: 18px;
  width: 100%;
  background: #101828;
  color: white;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  padding: 8px max(8px, env(safe-area-inset-left))
           calc(8px + env(safe-area-inset-bottom))
           max(8px, env(safe-area-inset-right));
  border-top: 1px solid #e5e7eb;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(14px);
}

.nav-item {
  min-height: 56px;
  border: 0;
  background: transparent;
  color: #98a2b3;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.nav-item span {
  font-size: 18px;
}

.nav-item small {
  font-size: 9px;
  font-weight: 800;
}

.nav-item.active {
  color: #101828;
}

@media (min-width: 700px) {
  .content {
    padding: 28px;
  }

  .quick-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .bottom-nav {
    left: 50%;
    right: auto;
    width: min(700px, 100%);
    transform: translateX(-50%);
    border: 1px solid #e5e7eb;
    border-bottom: 0;
    border-radius: 18px 18px 0 0;
  }
}
