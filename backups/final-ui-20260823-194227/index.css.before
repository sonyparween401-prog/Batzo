html,
body,
#root {
  margin: 0;
  min-height: 100%;
  width: 100%;
}

body {
  background: #030508;
}

:root {
  color-scheme: dark;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

html {
  background: #070a0f;
  overflow-x: hidden;
}

body {
  margin: 0;
  min-width: 320px;
  overflow-x: hidden;
  background: #070a0f;
}
