* {
  box-sizing: border-box;
}

:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #101828;
  background: #f4f6fb;
}

body {
  margin: 0;
  min-width: 320px;
}

button {
  font: inherit;
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% -10%, #dce9ff 0, transparent 35%),
    #f4f6fb;
  padding-bottom: 90px;
}

.top-header {
  height: 74px;
  padding: 0 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,.94);
  backdrop-filter: blur(15px);
  position: sticky;
  top: 0;
  z-index: 20;
  border-bottom: 1px solid #eaecf0;
}


.batzo-logo {
  width: 148px;
  height: auto;
  display: block;
  object-fit: contain;
  filter: drop-shadow(0 5px 14px rgba(80,120,255,.18));
}

.brand {
  display: flex;
  align-items: center;
}


.brand-ball {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: linear-gradient(135deg,#ff6b00,#ff2d55);
  box-shadow: 0 8px 22px rgba(255,77,0,.25);
  font-size: 22px;
}

.brand-name {
  font-weight: 1000;
  font-size: 20px;
  letter-spacing: 1.5px;
}

.brand-sub {
  color: #667085;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.6px;
}

.header-actions {
  display: flex;
  gap: 8px;
}

.icon-btn,
.profile-btn {
  border: 0;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: #f2f4f7;
}

.profile-btn {
  background: #101828;
  color: white;
}

main {
  width: min(1100px, 92%);
  margin: auto;
}

.hero {
  margin-top: 22px;
  min-height: 360px;
  border-radius: 30px;
  overflow: hidden;
  position: relative;
  color: white;
  display: flex;
  align-items: center;
  padding: 45px;
  background:
    radial-gradient(circle at 80% 20%, rgba(255,120,30,.55), transparent 30%),
    radial-gradient(circle at 70% 80%, rgba(100,50,255,.5), transparent 35%),
    linear-gradient(120deg,#101828,#172b55 55%,#1d1745);
  box-shadow: 0 22px 50px rgba(16,24,40,.2);
}

.hero-content {
  width: 60%;
  position: relative;
  z-index: 2;
}

.hero-tag,
.banner-small,
.small-label {
  font-size: 10px;
  font-weight: 950;
  letter-spacing: 1.6px;
  color: #ff8a3d;
}

.hero h1 {
  margin: 12px 0;
  font-size: clamp(38px,6vw,66px);
  line-height: .98;
  letter-spacing: -2px;
}

.hero h1 span {
  color: #ff8a3d;
}

.hero p {
  max-width: 500px;
  color: #d0d5dd;
  line-height: 1.6;
  font-size: 14px;
}

.hero-buttons {
  display: flex;
  gap: 10px;
  margin-top: 25px;
  flex-wrap: wrap;
}

.primary-btn,
.secondary-btn,
.banner-btn {
  border: 0;
  border-radius: 12px;
  padding: 13px 18px;
  font-weight: 950;
  font-size: 11px;
}

.primary-btn {
  background: linear-gradient(135deg,#ff7a18,#ff3d3d);
  color: white;
  box-shadow: 0 12px 25px rgba(255,73,35,.3);
}

.secondary-btn {
  background: rgba(255,255,255,.1);
  color: white;
  border: 1px solid rgba(255,255,255,.18);
}

.hero-cricket {
  position: absolute;
  right: 7%;
  top: 0;
  width: 38%;
  height: 100%;
  display: grid;
  place-items: center;
}

.stadium-glow {
  position: absolute;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background: rgba(255,100,20,.18);
  filter: blur(35px);
}

.big-ball {
  font-size: 105px;
  transform: rotate(-20deg);
  filter: drop-shadow(0 20px 30px rgba(0,0,0,.35));
}

.hero-score {
  position: absolute;
  bottom: 35px;
  right: 10%;
  background: rgba(0,0,0,.25);
  border: 1px solid rgba(255,255,255,.14);
  padding: 12px 18px;
  border-radius: 15px;
  text-align: center;
}

.hero-score span {
  display: block;
  color: #ff8a3d;
  font-size: 9px;
  font-weight: 900;
}

.hero-score strong {
  display: block;
  font-size: 25px;
}

.hero-score small {
  color: #d0d5dd;
  font-size: 8px;
}

section {
  margin-top: 35px;
}

.section-title {
  margin-bottom: 16px;
}

.section-title h2 {
  margin: 4px 0 0;
  font-size: 25px;
  letter-spacing: -.7px;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 12px;
}

.quick-card {
  padding: 17px;
  background: white;
  border: 1px solid #eaecf0;
  border-radius: 18px;
  display: flex;
  gap: 12px;
  align-items: center;
  box-shadow: 0 8px 22px rgba(16,24,40,.04);
}

.quick-card strong,
.quick-card span {
  display: block;
}

.quick-card strong {
  font-size: 13px;
}

.quick-card span {
  color: #98a2b3;
  font-size: 10px;
  margin-top: 4px;
}

.quick-icon {
  width: 42px;
  height: 42px;
  border-radius: 13px;
  display: grid;
  place-items: center;
  font-size: 19px;
}

.orange { background: #fff0e5; }
.purple { background: #f0eaff; }
.green { background: #e7f8ee; }
.blue { background: #e8f2ff; }

.row-title {
  display: flex;
  justify-content: space-between;
  align-items: end;
}

.view-all {
  border: 0;
  background: transparent;
  color: #475467;
  font-size: 11px;
  font-weight: 850;
}

.matches-list {
  display: grid;
  gap: 14px;
}

.match-card {
  background: white;
  border: 1px solid #eaecf0;
  border-radius: 22px;
  padding: 20px;
  box-shadow: 0 10px 28px rgba(16,24,40,.05);
}

.match-top,
.match-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.match-top {
  margin-bottom: 20px;
}

.status {
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .6px;
}

.status.live {
  background: #fee4e2;
  color: #b42318;
}

.status.upcoming {
  background: #eef4ff;
  color: #3538cd;
}

.league {
  color: #667085;
  font-size: 10px;
  font-weight: 750;
}

.teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 15px;
}

.team {
  display: grid;
  grid-template-columns: 48px 1fr auto;
  align-items: center;
  gap: 10px;
}

.team-right {
  text-align: right;
}

.team-logo {
  width: 48px;
  height: 48px;
  border-radius: 15px;
  background: linear-gradient(135deg,#172b55,#101828);
  color: white;
  display: grid;
  place-items: center;
  font-weight: 950;
  font-size: 11px;
}

.team strong {
  font-size: 13px;
}

.score {
  font-size: 14px;
  font-weight: 950;
}

.vs {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #f2f4f7;
  display: grid;
  place-items: center;
  color: #667085;
  font-size: 9px;
  font-weight: 950;
}

.match-bottom {
  margin-top: 20px;
  border-top: 1px solid #f2f4f7;
  padding-top: 15px;
}

.match-time {
  color: #667085;
  font-size: 10px;
  font-weight: 800;
}

.play-btn {
  border: 0;
  background: #101828;
  color: white;
  padding: 10px 15px;
  border-radius: 10px;
  font-size: 9px;
  font-weight: 900;
}

.banner {
  border-radius: 25px;
  padding: 30px;
  min-height: 220px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
  color: white;
  background:
    radial-gradient(circle at 80% 50%,rgba(255,140,40,.5),transparent 30%),
    linear-gradient(110deg,#17124a,#36248a);
}

.banner h2 {
  margin: 7px 0;
  font-size: 30px;
}

.banner p {
  color: #d0d5dd;
  max-width: 400px;
  font-size: 12px;
  line-height: 1.5;
}

.banner-btn {
  margin-top: 8px;
  background: white;
  color: #17124a;
}

.banner-art {
  font-size: 105px;
  transform: rotate(-10deg);
}

.leaderboard {
  background: white;
  padding: 22px;
  border: 1px solid #eaecf0;
  border-radius: 22px;
}

.leader-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-top: 1px solid #f2f4f7;
}

.rank {
  width: 25px;
  font-weight: 950;
  color: #667085;
}

.avatar {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #f2f4f7;
}

.player {
  flex: 1;
}

.player strong,
.player span {
  display: block;
}

.player strong {
  font-size: 12px;
}

.player span {
  color: #98a2b3;
  font-size: 9px;
  margin-top: 3px;
}

.points {
  font-size: 12px;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(620px,100%);
  height: 72px;
  background: rgba(255,255,255,.96);
  backdrop-filter: blur(18px);
  border: 1px solid #eaecf0;
  border-radius: 22px 22px 0 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 30;
  box-shadow: 0 -8px 30px rgba(16,24,40,.08);
}

.nav-item {
  border: 0;
  background: transparent;
  display: grid;
  place-items: center;
  gap: 3px;
  color: #98a2b3;
  font-size: 17px;
}

.nav-item small {
  font-size: 9px;
  font-weight: 800;
}

.nav-item.active {
  color: #ff5a1f;
}

.nav-play {
  width: 52px;
  height: 52px;
  border: 5px solid white;
  margin-top: -28px;
  border-radius: 50%;
  background: linear-gradient(135deg,#ff7a18,#ff304f);
  color: white;
  font-size: 20px;
  box-shadow: 0 8px 22px rgba(255,80,30,.35);
}

@media (max-width: 750px) {
  .hero {
    min-height: 470px;
    padding: 28px;
    align-items: flex-start;
  }

  .hero-content {
    width: 100%;
  }

  .hero-cricket {
    width: 100%;
    height: 190px;
    right: 0;
    bottom: 0;
    top: auto;
  }

  .big-ball {
    font-size: 75px;
  }

  .hero-score {
    bottom: 15px;
  }

  .quick-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .team {
    grid-template-columns: 42px 1fr;
  }

  .team .score {
    grid-column: 2;
  }
}

@media (max-width: 500px) {
  main {
    width: 94%;
  }

  .hero {
    border-radius: 23px;
  }

  .hero h1 {
    font-size: 43px;
  }

  .hero p {
    font-size: 12px;
  }

  .quick-card {
    padding: 12px;
  }

  .teams {
    gap: 7px;
  }

  .team {
    gap: 6px;
  }

  .team strong {
    font-size: 10px;
  }

  .team-logo {
    width: 42px;
    height: 42px;
  }

  .score {
    font-size: 11px;
  }

  .banner {
    min-height: 260px;
    padding: 23px;
  }

  .banner-art {
    font-size: 70px;
  }
}
