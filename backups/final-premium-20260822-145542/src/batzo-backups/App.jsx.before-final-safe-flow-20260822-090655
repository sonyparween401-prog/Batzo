/* BATZO_FULL_MATCH_FLOW */
function BatzoFullMatchScreen({ mode, matches = [], selected, onSelect, onBack }) {
  const list = Array.isArray(matches) ? matches : [];

  if (mode === "list") {
    return (
      <div className="batzo-flow-screen">
        <div className="batzo-flow-header">
          <button className="batzo-flow-back" onClick={onBack}>← HOME</button>
          <div>
            <div className="batzo-flow-kicker">BATZO CRICKET</div>
            <h1>Live & Upcoming</h1>
          </div>
        </div>

        <div className="batzo-flow-list">
          {list.map((m, i) => (
            <button
              key={i}
              className="batzo-flow-match"
              onClick={() => onSelect(m)}
              type="button"
            >
              <span className="batzo-flow-live">● LIVE</span>
              <strong>{m?.team1 || m?.homeTeam || m?.teamA || m?.team_a || "TEAM A"}</strong>
              <span className="batzo-flow-vs">VS</span>
              <strong>{m?.team2 || m?.awayTeam || m?.teamB || m?.team_b || "TEAM B"}</strong>
              <small>Tap to view match details →</small>
            </button>
          ))}

          {list.length === 0 && (
            <button className="batzo-flow-match" onClick={() => onSelect({})} type="button">
              <span className="batzo-flow-live">● LIVE</span>
              <strong>BATZO PREMIER LEAGUE</strong>
              <span className="batzo-flow-vs">VS</span>
              <strong>BATZO XI</strong>
              <small>Tap to view match details →</small>
            </button>
          )}
        </div>
      </div>
    );
  }

  const m = selected || {};
  const team1 = m?.team1 || m?.homeTeam || m?.teamA || m?.team_a || "BATZO XI";
  const team2 = m?.team2 || m?.awayTeam || m?.teamB || m?.team_b || "PREMIER XI";

  return (
    <div className="batzo-flow-screen">
      <div className="batzo-flow-header">
        <button className="batzo-flow-back" onClick={onBack}>← HOME</button>
        <div>
          <div className="batzo-flow-kicker">MATCH DETAILS</div>
          <h1>{team1} vs {team2}</h1>
        </div>
      </div>

      <div className="batzo-detail-card">
        <div className="batzo-detail-live">● LIVE MATCH</div>
        <div className="batzo-detail-teams">
          <strong>{team1}</strong>
          <span>VS</span>
          <strong>{team2}</strong>
        </div>

        <div className="batzo-detail-grid">
          <button type="button">🏏 LIVE SCORE</button>
          <button type="button">🏆 CONTESTS</button>
          <button type="button">👥 MY TEAM</button>
          <button type="button">ℹ️ MATCH INFO</button>
        </div>

        <button className="batzo-detail-back" onClick={onBack} type="button">
          ← BACK TO HOME
        </button>
      </div>
    </div>
  );
}

