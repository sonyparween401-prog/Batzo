* {
  box-sizing: border-box;
}

:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #101828;
  background: #f4f6fb;
}

body {
  margin: 0;
  min-width: 320px;
}

button {
  font: inherit;
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% -10%, #dce9ff 0, transparent 35%),
    #f4f6fb;
  padding-bottom: 90px;
}

.top-header {
  height: 74px;
  padding: 0 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,.94);
  backdrop-filter: blur(15px);
  position: sticky;
  top: 0;
  z-index: 20;
  border-bottom: 1px solid #eaecf0;
}


.batzo-logo {
  width: 148px;
  height: auto;
  display: block;
  object-fit: contain;
  filter: drop-shadow(0 5px 14px rgba(80,120,255,.18));
}

.brand {
  display: flex;
  align-items: center;
}


.brand-ball {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: linear-gradient(135deg,#ff6b00,#ff2d55);
  box-shadow: 0 8px 22px rgba(255,77,0,.25);
  font-size: 22px;
}

.brand-name {
  font-weight: 1000;
  font-size: 20px;
  letter-spacing: 1.5px;
}

.brand-sub {
  color: #667085;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.6px;
}

.header-actions {
  display: flex;
  gap: 8px;
}

.icon-btn,
.profile-btn {
  border: 0;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: #f2f4f7;
}

.profile-btn {
  background: #101828;
  color: white;
}

main {
  width: min(1100px, 92%);
  margin: auto;
}

.hero {
  margin-top: 22px;
  min-height: 360px;
  border-radius: 30px;
  overflow: hidden;
  position: relative;
  color: white;
  display: flex;
  align-items: center;
  padding: 45px;
  background:
    radial-gradient(circle at 80% 20%, rgba(255,120,30,.55), transparent 30%),
    radial-gradient(circle at 70% 80%, rgba(100,50,255,.5), transparent 35%),
    linear-gradient(120deg,#101828,#172b55 55%,#1d1745);
  box-shadow: 0 22px 50px rgba(16,24,40,.2);
}

.hero-content {
  width: 60%;
  position: relative;
  z-index: 2;
}

.hero-tag,
.banner-small,
.small-label {
  font-size: 10px;
  font-weight: 950;
  letter-spacing: 1.6px;
  color: #ff8a3d;
}

.hero h1 {
  margin: 12px 0;
  font-size: clamp(38px,6vw,66px);
  line-height: .98;
  letter-spacing: -2px;
}

.hero h1 span {
  color: #ff8a3d;
}

.hero p {
  max-width: 500px;
  color: #d0d5dd;
  line-height: 1.6;
  font-size: 14px;
}

.hero-buttons {
  display: flex;
  gap: 10px;
  margin-top: 25px;
  flex-wrap: wrap;
}

.primary-btn,
.secondary-btn,
.banner-btn {
  border: 0;
  border-radius: 12px;
  padding: 13px 18px;
  font-weight: 950;
  font-size: 11px;
}

.primary-btn {
  background: linear-gradient(135deg,#ff7a18,#ff3d3d);
  color: white;
  box-shadow: 0 12px 25px rgba(255,73,35,.3);
}

.secondary-btn {
  background: rgba(255,255,255,.1);
  color: white;
  border: 1px solid rgba(255,255,255,.18);
}

.hero-cricket {
  position: absolute;
  right: 7%;
  top: 0;
  width: 38%;
  height: 100%;
  display: grid;
  place-items: center;
}

.stadium-glow {
  position: absolute;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background: rgba(255,100,20,.18);
  filter: blur(35px);
}

.big-ball {
  font-size: 105px;
  transform: rotate(-20deg);
  filter: drop-shadow(0 20px 30px rgba(0,0,0,.35));
}

.hero-score {
  position: absolute;
  bottom: 35px;
  right: 10%;
  background: rgba(0,0,0,.25);
  border: 1px solid rgba(255,255,255,.14);
  padding: 12px 18px;
  border-radius: 15px;
  text-align: center;
}

.hero-score span {
  display: block;
  color: #ff8a3d;
  font-size: 9px;
  font-weight: 900;
}

.hero-score strong {
  display: block;
  font-size: 25px;
}

.hero-score small {
  color: #d0d5dd;
  font-size: 8px;
}

section {
  margin-top: 35px;
}

.section-title {
  margin-bottom: 16px;
}

.section-title h2 {
  margin: 4px 0 0;
  font-size: 25px;
  letter-spacing: -.7px;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 12px;
}

.quick-card {
  padding: 17px;
  background: white;
  border: 1px solid #eaecf0;
  border-radius: 18px;
  display: flex;
  gap: 12px;
  align-items: center;
  box-shadow: 0 8px 22px rgba(16,24,40,.04);
}

.quick-card strong,
.quick-card span {
  display: block;
}

.quick-card strong {
  font-size: 13px;
}

.quick-card span {
  color: #98a2b3;
  font-size: 10px;
  margin-top: 4px;
}

.quick-icon {
  width: 42px;
  height: 42px;
  border-radius: 13px;
  display: grid;
  place-items: center;
  font-size: 19px;
}

.orange { background: #fff0e5; }
.purple { background: #f0eaff; }
.green { background: #e7f8ee; }
.blue { background: #e8f2ff; }

.row-title {
  display: flex;
  justify-content: space-between;
  align-items: end;
}

.view-all {
  border: 0;
  background: transparent;
  color: #475467;
  font-size: 11px;
  font-weight: 850;
}

.matches-list {
  display: grid;
  gap: 14px;
}

.match-card {
  background: white;
  border: 1px solid #eaecf0;
  border-radius: 22px;
  padding: 20px;
  box-shadow: 0 10px 28px rgba(16,24,40,.05);
}

.match-top,
.match-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.match-top {
  margin-bottom: 20px;
}

.status {
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .6px;
}

.status.live {
  background: #fee4e2;
  color: #b42318;
}

.status.upcoming {
  background: #eef4ff;
  color: #3538cd;
}

.league {
  color: #667085;
  font-size: 10px;
  font-weight: 750;
}

.teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 15px;
}

.team {
  display: grid;
  grid-template-columns: 48px 1fr auto;
  align-items: center;
  gap: 10px;
}

.team-right {
  text-align: right;
}

.team-logo {
  width: 48px;
  height: 48px;
  border-radius: 15px;
  background: linear-gradient(135deg,#172b55,#101828);
  color: white;
  display: grid;
  place-items: center;
  font-weight: 950;
  font-size: 11px;
}

.team strong {
  font-size: 13px;
}

.score {
  font-size: 14px;
  font-weight: 950;
}

.vs {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #f2f4f7;
  display: grid;
  place-items: center;
  color: #667085;
  font-size: 9px;
  font-weight: 950;
}

.match-bottom {
  margin-top: 20px;
  border-top: 1px solid #f2f4f7;
  padding-top: 15px;
}

.match-time {
  color: #667085;
  font-size: 10px;
  font-weight: 800;
}

.play-btn {
  border: 0;
  background: #101828;
  color: white;
  padding: 10px 15px;
  border-radius: 10px;
  font-size: 9px;
  font-weight: 900;
}

.banner {
  border-radius: 25px;
  padding: 30px;
  min-height: 220px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
  color: white;
  background:
    radial-gradient(circle at 80% 50%,rgba(255,140,40,.5),transparent 30%),
    linear-gradient(110deg,#17124a,#36248a);
}

.banner h2 {
  margin: 7px 0;
  font-size: 30px;
}

.banner p {
  color: #d0d5dd;
  max-width: 400px;
  font-size: 12px;
  line-height: 1.5;
}

.banner-btn {
  margin-top: 8px;
  background: white;
  color: #17124a;
}

.banner-art {
  font-size: 105px;
  transform: rotate(-10deg);
}

.leaderboard {
  background: white;
  padding: 22px;
  border: 1px solid #eaecf0;
  border-radius: 22px;
}

.leader-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-top: 1px solid #f2f4f7;
}

.rank {
  width: 25px;
  font-weight: 950;
  color: #667085;
}

.avatar {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #f2f4f7;
}

.player {
  flex: 1;
}

.player strong,
.player span {
  display: block;
}

.player strong {
  font-size: 12px;
}

.player span {
  color: #98a2b3;
  font-size: 9px;
  margin-top: 3px;
}

.points {
  font-size: 12px;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(620px,100%);
  height: 72px;
  background: rgba(255,255,255,.96);
  backdrop-filter: blur(18px);
  border: 1px solid #eaecf0;
  border-radius: 22px 22px 0 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 30;
  box-shadow: 0 -8px 30px rgba(16,24,40,.08);
}

.nav-item {
  border: 0;
  background: transparent;
  display: grid;
  place-items: center;
  gap: 3px;
  color: #98a2b3;
  font-size: 17px;
}

.nav-item small {
  font-size: 9px;
  font-weight: 800;
}

.nav-item.active {
  color: #ff5a1f;
}

.nav-play {
  width: 52px;
  height: 52px;
  border: 5px solid white;
  margin-top: -28px;
  border-radius: 50%;
  background: linear-gradient(135deg,#ff7a18,#ff304f);
  color: white;
  font-size: 20px;
  box-shadow: 0 8px 22px rgba(255,80,30,.35);
}

@media (max-width: 750px) {
  .hero {
    min-height: 470px;
    padding: 28px;
    align-items: flex-start;
  }

  .hero-content {
    width: 100%;
  }

  .hero-cricket {
    width: 100%;
    height: 190px;
    right: 0;
    bottom: 0;
    top: auto;
  }

  .big-ball {
    font-size: 75px;
  }

  .hero-score {
    bottom: 15px;
  }

  .quick-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .team {
    grid-template-columns: 42px 1fr;
  }

  .team .score {
    grid-column: 2;
  }
}

@media (max-width: 500px) {
  main {
    width: 94%;
  }

  .hero {
    border-radius: 23px;
  }

  .hero h1 {
    font-size: 43px;
  }

  .hero p {
    font-size: 12px;
  }

  .quick-card {
    padding: 12px;
  }

  .teams {
    gap: 7px;
  }

  .team {
    gap: 6px;
  }

  .team strong {
    font-size: 10px;
  }

  .team-logo {
    width: 42px;
    height: 42px;
  }

  .score {
    font-size: 11px;
  }

  .banner {
    min-height: 260px;
    padding: 23px;
  }

  .banner-art {
    font-size: 70px;
  }
}

/* =========================================================
   BATZO PREMIUM UI POLISH
   Colourful Cricket + Luxury Gaming
   ========================================================= */

:root {
  --batzo-bg: #f5f7fb;
  --batzo-dark: #080b14;
  --batzo-dark-2: #111827;
  --batzo-gold: #f5c542;
  --batzo-orange: #ff7a18;
  --batzo-pink: #ff3d81;
  --batzo-blue: #19d9ff;
  --batzo-purple: #7357ff;
}

/* ---------- GLOBAL ---------- */

body {
  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(25, 217, 255, .08),
      transparent 35%
    ),
    #f5f7fb;
}

.app-shell {
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(115, 87, 255, .07),
      transparent 28%
    ),
    #f5f7fb;
}

/* ---------- PREMIUM HEADER ---------- */

.top-header {
  height: 82px;
  padding: 0 5%;
  background:
    linear-gradient(
      110deg,
      #070a12 0%,
      #0d1220 48%,
      #12172a 100%
    );
  border-bottom: 1px solid rgba(245,197,66,.22);
  box-shadow:
    0 8px 30px rgba(0,0,0,.16),
    0 1px 0 rgba(255,255,255,.04) inset;
}

.brand {
  min-width: 170px;
}

.batzo-logo {
  width: 178px;
  height: 66px;
  object-fit: contain;
  filter:
    drop-shadow(0 4px 8px rgba(0,0,0,.35))
    drop-shadow(0 0 14px rgba(25,217,255,.12));
  transform: scale(1.08);
}

.header-actions {
  gap: 10px;
}

.icon-btn,
.profile-btn {
  width: 43px;
  height: 43px;
  border-radius: 14px;
  transition: transform .2s ease, box-shadow .2s ease;
}

.icon-btn {
  background: rgba(255,255,255,.08);
  color: white;
  border: 1px solid rgba(255,255,255,.10);
}

.profile-btn {
  background:
    linear-gradient(
      135deg,
      #1c2942,
      #080b14
    );
  color: #19d9ff;
  border: 1px solid rgba(25,217,255,.22);
}

.icon-btn:active,
.profile-btn:active {
  transform: scale(.94);
}

/* ---------- HERO ---------- */

.hero {
  margin-top: 24px;
  min-height: 410px;
  padding: 42px;
  border-radius: 30px;

  background:
    radial-gradient(
      circle at 82% 18%,
      rgba(255,122,24,.30),
      transparent 25%
    ),
    radial-gradient(
      circle at 78% 82%,
      rgba(115,87,255,.28),
      transparent 31%
    ),
    radial-gradient(
      circle at 20% 90%,
      rgba(25,217,255,.10),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      #080b14 0%,
      #10182b 48%,
      #17122d 100%
    );

  border: 1px solid rgba(245,197,66,.16);

  box-shadow:
    0 25px 60px rgba(7,10,18,.24),
    0 0 0 1px rgba(255,255,255,.025) inset;
}

.hero:after {
  content: "";
  position: absolute;
  inset: 1px;
  border-radius: 29px;
  pointer-events: none;

  background:
    linear-gradient(
      120deg,
      rgba(255,255,255,.06),
      transparent 35%,
      transparent 70%,
      rgba(245,197,66,.04)
    );
}

.hero-content {
  width: 61%;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  padding: 7px 11px;
  border-radius: 999px;

  background: rgba(255,122,24,.10);
  border: 1px solid rgba(255,122,24,.22);

  color: #ff9a4d;
  font-size: 9px;
  letter-spacing: 1.7px;
  box-shadow: 0 0 18px rgba(255,122,24,.08);
}

.hero h1 {
  margin: 17px 0 13px;
  font-size: clamp(40px,6vw,64px);
  line-height: .98;
  letter-spacing: -2.8px;
  text-shadow: 0 8px 30px rgba(0,0,0,.22);
}

.hero h1 span {
  background:
    linear-gradient(
      90deg,
      #ff7a18,
      #ff3d81 48%,
      #19d9ff
    );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero p {
  max-width: 470px;
  color: #b8c1d1;
  font-size: 13px;
  line-height: 1.7;
}

.hero-buttons {
  margin-top: 26px;
}

.primary-btn {
  min-width: 145px;
  padding: 14px 20px;

  background:
    linear-gradient(
      135deg,
      #ff7a18,
      #ff3d81
    );

  border: 1px solid rgba(255,255,255,.14);

  box-shadow:
    0 12px 28px rgba(255,61,129,.20),
    0 4px 12px rgba(255,122,24,.20);
}

.secondary-btn {
  min-width: 145px;
  padding: 14px 20px;

  background: rgba(255,255,255,.055);
  border: 1px solid rgba(255,255,255,.16);

  backdrop-filter: blur(10px);
}

.primary-btn:active,
.secondary-btn:active,
.play-btn:active,
.banner-btn:active {
  transform: translateY(1px) scale(.98);
}

/* ---------- HERO CRICKET ---------- */

.hero-cricket {
  width: 38%;
}

.big-ball {
  font-size: 108px;
  filter:
    drop-shadow(0 25px 25px rgba(0,0,0,.35))
    drop-shadow(0 0 22px rgba(255,122,24,.12));
}

.hero-score {
  right: 5%;
  bottom: 34px;

  min-width: 145px;
  padding: 13px 19px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.08),
      rgba(255,255,255,.025)
    );

  border: 1px solid rgba(245,197,66,.22);

  box-shadow:
    0 12px 30px rgba(0,0,0,.22),
    0 0 20px rgba(245,197,66,.06);
}

.hero-score span {
  color: #ff6b6b;
  letter-spacing: 1.2px;
}

/* ---------- SECTION TITLES ---------- */

.small-label {
  color: #9b6d00;
  letter-spacing: 1.8px;
}

.section-title h2 {
  color: #101828;
  font-weight: 950;
}

/* ---------- QUICK GAME CENTER ---------- */

.quick-card {
  position: relative;
  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f9fafb
    );

  border: 1px solid #eaecf0;

  box-shadow:
    0 10px 28px rgba(16,24,40,.045),
    0 1px 0 white inset;

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}

.quick-card:before {
  content: "";
  position: absolute;
  width: 70px;
  height: 70px;
  right: -35px;
  top: -35px;
  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(245,197,66,.14),
      transparent 70%
    );
}

.quick-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 35px rgba(16,24,40,.09);
}

.quick-icon {
  box-shadow: 0 6px 14px rgba(16,24,40,.06);
}

/* ---------- MATCH CARDS ---------- */

.match-card {
  position: relative;
  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #fafbfc
    );

  border: 1px solid #e7eaf0;

  box-shadow:
    0 12px 32px rgba(16,24,40,.055);
}

.match-card:before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 3px;

  background:
    linear-gradient(
      90deg,
      #ff7a18,
      #ff3d81,
      #19d9ff
    );
}

.status.live {
  box-shadow: 0 0 0 4px rgba(180,35,24,.05);
}

.team-logo {
  background:
    linear-gradient(
      135deg,
      #101828,
      #283657
    );

  border: 1px solid rgba(245,197,66,.20);

  box-shadow:
    0 7px 18px rgba(16,24,40,.13);
}

.vs {
  background:
    linear-gradient(
      135deg,
      #fff9df,
      #f7f0d2
    );

  color: #8b6800;
  border: 1px solid rgba(245,197,66,.24);
}

.play-btn {
  background:
    linear-gradient(
      135deg,
      #101828,
      #1f2b46
    );

  border: 1px solid rgba(245,197,66,.20);

  box-shadow:
    0 6px 15px rgba(16,24,40,.12);
}

/* ---------- REWARD BANNER ---------- */

.banner {
  position: relative;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 85% 35%,
      rgba(255,122,24,.30),
      transparent 28%
    ),
    radial-gradient(
      circle at 65% 90%,
      rgba(25,217,255,.14),
      transparent 25%
    ),
    linear-gradient(
      120deg,
      #080b14,
      #121b31 55%,
      #21152e
    );

  border: 1px solid rgba(245,197,66,.18);

  box-shadow:
    0 20px 45px rgba(16,24,40,.16);
}

.banner-small {
  color: #f5c542;
}

.banner h2 {
  font-size: 31px;
  letter-spacing: -1px;
}

.banner-art {
  filter:
    drop-shadow(0 15px 25px rgba(0,0,0,.35))
    drop-shadow(0 0 22px rgba(245,197,66,.10));
}

/* ---------- LEADERBOARD ---------- */

.leaderboard {
  box-shadow: 0 12px 30px rgba(16,24,40,.05);
}

.leader-row.first {
  background:
    linear-gradient(
      90deg,
      rgba(245,197,66,.08),
      transparent
    );

  border-radius: 13px;
  padding-left: 9px;
  padding-right: 9px;
}

.rank {
  color: #b18400;
}

.points {
  color: #8b6800;
}

/* ---------- PREMIUM BOTTOM NAV ---------- */

.bottom-nav {
  height: 76px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.98),
      rgba(247,248,250,.98)
    );

  border-top: 1px solid rgba(16,24,40,.08);

  box-shadow:
    0 -10px 35px rgba(16,24,40,.10);
}

.nav-item {
  transition: transform .2s ease;
}

.nav-item.active {
  color: #e06b00;
  font-weight: 900;
}

.nav-play {
  width: 58px;
  height: 58px;

  background:
    linear-gradient(
      135deg,
      #ff7a18,
      #ff3d81
    );

  border: 5px solid #ffffff;

  box-shadow:
    0 9px 25px rgba(255,61,129,.28),
    0 0 0 1px rgba(245,197,66,.15);
}

.nav-play span {
  filter: drop-shadow(0 2px 3px rgba(0,0,0,.18));
}

/* ---------- MOBILE ---------- */

@media (max-width: 750px) {

  .top-header {
    height: 76px;
    padding: 0 18px;
  }

  .batzo-logo {
    width: 170px;
    height: 62px;
    transform: scale(1.02);
  }

  main {
    width: 94%;
  }

  .hero {
    min-height: 430px;
    padding: 30px 24px;
    margin-top: 18px;
    border-radius: 25px;
  }

  .hero-content {
    width: 100%;
  }

  .hero h1 {
    font-size: 43px;
    letter-spacing: -2px;
  }

  .hero p {
    font-size: 12px;
    max-width: 360px;
  }

  .hero-cricket {
    width: 100%;
    height: 175px;
  }

  .big-ball {
    font-size: 78px;
  }

  .hero-score {
    right: 3%;
    bottom: 10px;
    min-width: 130px;
  }

  .quick-grid {
    gap: 10px;
  }

  .quick-card {
    min-height: 68px;
  }

  .match-card {
    border-radius: 19px;
    padding: 17px;
  }

  .banner {
    padding: 24px;
    border-radius: 21px;
  }

  .banner h2 {
    font-size: 27px;
  }

  .bottom-nav {
    border-radius: 20px 20px 0 0;
  }
}

/* ---------- SMALL PHONES ---------- */

@media (max-width: 390px) {

  .batzo-logo {
    width: 154px;
  }

  .header-actions {
    gap: 6px;
  }

  .icon-btn,
  .profile-btn {
    width: 39px;
    height: 39px;
  }

  .hero {
    min-height: 420px;
    padding: 27px 20px;
  }

  .hero h1 {
    font-size: 39px;
  }

  .hero-buttons {
    gap: 8px;
  }

  .primary-btn,
  .secondary-btn {
    min-width: 0;
    padding: 12px 14px;
    font-size: 10px;
  }
}

/* ---------- SUBTLE MOTION ---------- */

@media (prefers-reduced-motion: no-preference) {

  .big-ball {
    animation: batzoFloat 4s ease-in-out infinite;
  }

  .nav-play {
    animation: batzoPulse 3s ease-in-out infinite;
  }

  @keyframes batzoFloat {
    0%, 100% {
      transform: translateY(0) rotate(-20deg);
    }

    50% {
      transform: translateY(-8px) rotate(-16deg);
    }
  }

  @keyframes batzoPulse {
    0%, 100% {
      box-shadow:
        0 9px 25px rgba(255,61,129,.28),
        0 0 0 1px rgba(245,197,66,.15);
    }

    50% {
      box-shadow:
        0 12px 32px rgba(255,61,129,.38),
        0 0 0 5px rgba(245,197,66,.06);
    }
  }
}

