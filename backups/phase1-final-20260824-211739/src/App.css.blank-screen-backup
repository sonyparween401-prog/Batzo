  background: linear-gradient(145deg, rgba(53,167,255,.15), rgba(35,108,255,.05)) !important;
  border: 1px solid rgba(53,167,255,.16) !important;
  color: #e2f2ff !important;
}

/* ---------- MOBILE SPACING ---------- */

@media (max-width: 600px) {

  .home,
  .home-page,
  .main-content,
  main {
    padding-bottom: 92px !important;
  }

  .matches-section {
    padding-left: 12px;
    padding-right: 12px;
  }

  .matches-list {
    gap: 10px;
  }

  .match-card,
  .match,
  .matches-list > div {
    border-radius: 16px !important;
  }

  .bottom-nav {
    left: 8px !important;
    right: 8px !important;
    bottom: 8px !important;
  }
}

/* ---------- VERY SMALL PHONES ---------- */

@media (max-width: 360px) {

  .bottom-nav {
    left: 5px !important;
    right: 5px !important;
  }

  .nav-item {
    min-width: 48px;
    padding-left: 4px !important;
    padding-right: 4px !important;
  }

  .nav-play {
    width: 49px !important;
    height: 49px !important;
  }
}

/* ---------- SMOOTH UI ---------- */

* {
  box-sizing: border-box;
}

button,
.match-card,
.match,
.nav-item,
.nav-play {
  touch-action: manipulation;
}

::selection {
  background: rgba(33,230,138,.25);
  color: #ffffff;
}

/* =========================================================
   END BATZO HOME SCREEN POLISH
   ========================================================= */


/* =========================================================
   BATZO WORK #2 — DREAM11 STYLE MATCH DETAILS
   ========================================================= */

.batzo-match-details {
  position: fixed;
  inset: 0;
  z-index: 5000;
  overflow-y: auto;
  padding: 0 12px 105px;
  background:
    radial-gradient(circle at 50% -8%, rgba(35,108,255,.22), transparent 32%),
    radial-gradient(circle at 10% 35%, rgba(33,230,138,.08), transparent 28%),
    #070b12;
  color: #f5f8ff;
  animation: bdIn .22s ease-out;
}

@keyframes bdIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

.bd-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 68px;
  background: rgba(7,11,18,.90);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.bd-topbar strong {
  display: block;
  font-size: 16px;
  font-weight: 950;
}

.bd-topbar small {
  display: block;
  margin-top: 2px;
  color: #78869a;
  font-size: 9px;
  font-weight: 800;
}

.bd-back {
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 13px;
  background: rgba(255,255,255,.05);
  color: #fff;
  font-size: 30px;
  line-height: 1;
}

.bd-live-dot {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6px;
  color: #21e68a;
  font-size: 9px;
  font-weight: 950;
}

.bd-live-dot span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #21e68a;
  box-shadow: 0 0 10px #21e68a;
}

.bd-score-card {
  position: relative;
  overflow: hidden;
  padding: 17px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 21px;
  background:
    radial-gradient(circle at 50% 80%, rgba(53,167,255,.10), transparent 35%),
    linear-gradient(145deg,#121d2b,#0a111b);
  box-shadow:
    0 18px 42px rgba(0,0,0,.34),
    inset 0 1px 0 rgba(255,255,255,.05);
}

.bd-score-card::after {
  content: "";
  position: absolute;
  width: 130px;
  height: 130px;
  right: -70px;
  top: -60px;
  border-radius: 50%;
  background: rgba(33,230,138,.10);
  filter: blur(10px);
}

.bd-match-meta {
  display: flex;
  justify-content: space-between;
  color: #8290a3;
  font-size: 9px;
  font-weight: 850;
}

.bd-match-meta span:first-child {
  color: #35a7ff;
}

.bd-status {
  text-align: center;
  margin: 12px 0 5px;
}

.bd-live,
.bd-upcoming {
  display: inline-block;
  padding: 5px 10px;
  border-radius: 99px;
  font-size: 9px;
  font-weight: 950;
  letter-spacing: .7px;
}

.bd-live {
  color: #fff;
  background: rgba(255,71,87,.15);
  border: 1px solid rgba(255,71,87,.30);
}

.bd-upcoming {
  color: #35a7ff;
  background: rgba(53,167,255,.10);
  border: 1px solid rgba(53,167,255,.22);
}

.bd-teams {
  display: grid;
  grid-template-columns: 1fr 50px 1fr;
  align-items: center;
  gap: 5px;
  margin-top: 10px;
}

.bd-team {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.bd-team-logo {
  display: grid;
  place-items: center;
  width: 57px;
  height: 57px;
  margin-bottom: 8px;
  border-radius: 17px;
  background: linear-gradient(145deg,#163c30,#0b1d18);
  border: 1px solid rgba(33,230,138,.20);
  box-shadow: 0 8px 20px rgba(0,0,0,.25);
  font-size: 25px;
}

.bd-team-logo-blue {
  background: linear-gradient(145deg,#173657,#0b1b2d);
  border-color: rgba(53,167,255,.22);
}

.bd-team strong {
  max-width: 115px;
  color: #fff;
  font-size: 12px;
  font-weight: 950;
}

.bd-team b {
  margin-top: 6px;
  color: #fff;
  font-size: 23px;
  font-weight: 950;
}

.bd-team small {
  margin-top: 2px;
  color: #758397;
  font-size: 8px;
  font-weight: 850;
}

.bd-vs {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  color: #647287;
}

.bd-vs span {
  color: #fff;
  font-size: 11px;
  font-weight: 950;
}

.bd-vs small {
  color: #21e68a;
}

.bd-match-info {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,.06);
  color: #8d9bad;
  font-size: 9px;
  font-weight: 800;
}

.bd-live-score {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
  padding: 12px;
  border-radius: 14px;
  background: rgba(33,230,138,.055);
  border: 1px solid rgba(33,230,138,.10);
}

.bd-live-score small,
.bd-overs small {
  display: block;
  color: #728196;
  font-size: 8px;
  font-weight: 900;
}

.bd-live-score strong {
  display: block;
  margin-top: 3px;
  color: #fff;
  font-size: 16px;
  font-weight: 950;
}

.bd-live-score em {
  color: #21e68a;
  font-style: normal;
  font-size: 10px;
}

.bd-overs {
  text-align: right;
}

.bd-overs strong {
  display: block;
  margin-top: 3px;
  color: #35a7ff;
  font-size: 17px;
  font-weight: 950;
}

.bd-join-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  padding: 15px;
  border-radius: 18px;
  background:
    linear-gradient(135deg,rgba(33,230,138,.13),rgba(35,108,255,.09));
  border: 1px solid rgba(33,230,138,.17);
}

.bd-join-box small,
.bd-join-box span {
  display: block;
  color: #8b99ab;
  font-size: 8px;
  font-weight: 900;
}

.bd-join-box strong {
  display: block;
  margin: 2px 0;
  color: #fff;
  font-size: 20px;
  font-weight: 950;
}

.bd-join-box button,
.bd-contest-row button,
.bd-primary-action {
  border: 0;
  border-radius: 12px;
  padding: 12px 16px;
  background: linear-gradient(135deg,#21e68a,#0bbf6a);
  color: #03140c;
  font-size: 10px;
  font-weight: 950;
  box-shadow: 0 8px 20px rgba(33,230,138,.18);
}

.bd-tabs {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 6px;
  margin-top: 14px;
  padding: 5px;
  border-radius: 16px;
  background: #0e1622;
  border: 1px solid rgba(255,255,255,.06);
}

.bd-tabs button {
  min-height: 48px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: #718096;
  font-size: 15px;
}

.bd-tabs button span {
  display: block;
  margin-top: 2px;
  font-size: 9px;
  font-weight: 900;
}

.bd-tabs button.active {
  color: #21e68a;
  background: rgba(33,230,138,.08);
  box-shadow: inset 0 0 0 1px rgba(33,230,138,.10);
}

.bd-content {
  margin-top: 18px;
}

.bd-section-title {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 10px;
}

.bd-section-title small {
  color: #21e68a;
  font-size: 8px;
  font-weight: 950;
  letter-spacing: .7px;
}

.bd-section-title h2 {
  margin: 3px 0 0;
  color: #fff;
  font-size: 17px;
  font-weight: 950;
}

.bd-section-title button {
  border: 0;
  background: transparent;
  color: #35a7ff;
  font-size: 9px;
  font-weight: 900;
}

.bd-contest-card {
  margin-bottom: 10px;
  padding: 14px;
  border-radius: 17px;
  background: linear-gradient(145deg,#111c2a,#0b121d);
  border: 1px solid rgba(255,255,255,.07);
  box-shadow: 0 10px 25px rgba(0,0,0,.24);
}

.bd-contest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bd-contest-head small {
  display: block;
  color: #7f8da0;
  font-size: 8px;
  font-weight: 900;
}

.bd-contest-head strong {
  display: block;
  margin-top: 3px;
  color: #fff;
  font-size: 18px;
  font-weight: 950;
}

.bd-contest-head > span {
  padding: 5px 8px;
  border-radius: 99px;
  color: #21e68a;
  background: rgba(33,230,138,.08);
  font-size: 8px;
  font-weight: 950;
}

.bd-contest-head > span.safe {
  color: #35a7ff;
  background: rgba(53,167,255,.08);
}

.bd-contest-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr auto;
  align-items: center;
  gap: 8px;
  margin-top: 13px;
  padding-top: 11px;
  border-top: 1px solid rgba(255,255,255,.06);
}

.bd-contest-row small {
  display: block;
  color: #68778b;
  font-size: 7px;
  font-weight: 900;
}

.bd-contest-row b {
  display: block;
  margin-top: 3px;
  color: #e9f0f8;
  font-size: 11px;
  font-weight: 900;
}

.bd-empty-state {
  margin-top: 25px;
  padding: 35px 20px;
  text-align: center;
  border-radius: 20px;
  background: #0d1622;
  border: 1px solid rgba(255,255,255,.06);
}

.bd-empty-state > div {
  font-size: 42px;
}

.bd-empty-state h2 {
  margin: 10px 0 5px;
  color: #fff;
  font-size: 20px;
}

.bd-empty-state p {
  margin: 0 auto 18px;
  max-width: 260px;
  color: #7e8b9e;
  font-size: 11px;
  line-height: 1.5;
}

.bd-info-list {
  margin-top: 16px;
  padding: 4px 15px;
  border-radius: 18px;
  background: #0d1622;
  border: 1px solid rgba(255,255,255,.06);
}

.bd-info-list div {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 15px 0;
  border-bottom: 1px solid rgba(255,255,255,.055);
}

.bd-info-list div:last-child {
  border-bottom: 0;
}

.bd-info-list span {
  color: #8491a3;
  font-size: 10px;
  font-weight: 800;
}

.bd-info-list strong {
  color: #fff;
  text-align: right;
  font-size: 10px;
  font-weight: 900;
}

@media (max-width: 360px) {
  .bd-team strong {
    max-width: 90px;
    font-size: 10px;
  }

  .bd-contest-row {
    gap: 5px;
  }

  .bd-join-box button {
    padding: 11px 12px;
  }
}

/* =========================================================
   END MATCH DETAILS
   ========================================================= */

