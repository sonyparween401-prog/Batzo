html,
body,
#root {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100%;
  background: #070b11;
}

body {
  min-height: 100vh;
}

/* ============================================================
   BATZO FINAL MOBILE UI FIX
   ============================================================ */

html,
body,
#root {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  overflow-x: hidden;
}

body {
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

img,
svg,
video {
  max-width: 100%;
  height: auto;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  max-width: 100%;
}

.app-shell,
.app,
.home,
.home-screen,
.page,
.main-content,
main {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: hidden;
}

.top-header,
.header,
.navbar,
.app-header {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
}

.top-header img,
.header img,
.navbar img,
.app-header img,
.logo,
.brand-logo,
.batzo-logo {
  width: min(72vw, 420px);
  max-width: 72vw;
  height: auto;
  object-fit: contain;
  display: block;
  margin-left: auto;
  margin-right: auto;
}

.hero,
.hero-section,
.hero-card,
.featured,
.featured-card {
  width: calc(100% - 24px);
  max-width: 680px;
  min-width: 0;
  margin-left: auto;
  margin-right: auto;
  overflow: hidden;
}

.hero-content,
.hero-inner {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding: 22px 20px;
  overflow: hidden;
}

.hero h1,
.hero-title,
.hero-content h1 {
  width: 100%;
  max-width: 100%;
  margin: 0 0 14px;
  font-size: clamp(2rem, 8vw, 4rem);
  line-height: 0.98;
  letter-spacing: -0.04em;
  overflow-wrap: anywhere;
  word-break: normal;
}

.hero p,
.hero-subtitle,
.hero-content p {
  max-width: 100%;
  font-size: clamp(0.95rem, 4vw, 1.2rem);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.hero-actions,
.hero-buttons,
.action-buttons,
.cta-buttons {
  width: 100%;
  max-width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: stretch;
}

.hero-actions button,
.hero-buttons button,
.action-buttons button,
.cta-buttons button {
  flex: 1 1 150px;
  min-width: 0;
  max-width: 100%;
  min-height: 46px;
  padding: 10px 14px;
  border-radius: 12px;
  white-space: normal;
  overflow-wrap: anywhere;
}

.quick-access,
.quick-access-section,
.game-center,
.game-center-section,
.matches-section,
.contests-section {
  width: calc(100% - 24px);
  max-width: 680px;
  min-width: 0;
  margin-left: auto;
  margin-right: auto;
}

.quick-access h1,
.quick-access h2,
.quick-access h3,
.game-center h1,
.game-center h2,
.game-center h3 {
  max-width: 100%;
  font-size: clamp(1.45rem, 7vw, 2.5rem);
  line-height: 1.1;
  overflow-wrap: anywhere;
}

.quick-access p,
.game-center p,
.match-card p,
.contest-card p {
  max-width: 100%;
  font-size: clamp(0.9rem, 4vw, 1.1rem);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.match-card,
.contest-card,
.game-card,
.card {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
}

.live-score,
.score,
.match-score {
  max-width: 100%;
  font-size: clamp(1rem, 5vw, 1.7rem);
  line-height: 1.25;
  white-space: normal;
  overflow-wrap: anywhere;
}

.bottom-nav,
.bottom-navigation {
  width: 100%;
  max-width: 100%;
  left: 0;
  right: 0;
  overflow: hidden;
}

.safe-flow,
.safe-flow-page {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: hidden;
}

.safe-flow-page {
  padding: 18px 14px;
}

.safe-flow-page h1,
.safe-flow-page h2,
.safe-flow-page h3 {
  font-size: clamp(1.35rem, 6vw, 2.2rem);
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.safe-flow-page button {
  max-width: 100%;
  min-height: 44px;
  padding: 9px 14px;
  border-radius: 10px;
}

@media (max-width: 480px) {
  html {
    font-size: 15px;
  }

  .top-header,
  .header,
  .navbar,
  .app-header {
    padding-left: 10px;
    padding-right: 10px;
  }

  .top-header img,
  .header img,
  .navbar img,
  .app-header img,
  .logo,
  .brand-logo,
  .batzo-logo {
    width: min(82vw, 330px);
    max-width: 82vw;
  }

  .hero,
  .hero-section,
  .hero-card,
  .featured,
  .featured-card,
  .quick-access,
  .quick-access-section,
  .game-center,
  .game-center-section,
  .matches-section,
  .contests-section {
    width: calc(100% - 16px);
  }

  .hero-content,
  .hero-inner {
    padding: 18px 16px;
  }

  .hero h1,
  .hero-title,
  .hero-content h1 {
    font-size: clamp(2rem, 10vw, 3.1rem);
  }

  .hero-actions,
  .hero-buttons,
  .action-buttons,
  .cta-buttons {
    flex-direction: column;
  }

  .hero-actions button,
  .hero-buttons button,
  .action-buttons button,
  .cta-buttons button {
    width: 100%;
    flex: 1 1 auto;
  }
}

@media (min-width: 481px) and (max-width: 768px) {
  .top-header img,
  .header img,
  .navbar img,
  .app-header img,
  .logo,
  .brand-logo,
  .batzo-logo {
    width: min(68vw, 420px);
  }

  .hero-content,
  .hero-inner {
    padding: 24px 22px;
  }
}

/* Prevent accidental oversized text from old desktop rules */
h1 {
  max-width: 100%;
}

p,
span,
div,
button {
  overflow-wrap: anywhere;
}

/* Keep emoji/icons from expanding layout */
svg,
img,
.emoji,
.icon {
  flex-shrink: 0;
}

