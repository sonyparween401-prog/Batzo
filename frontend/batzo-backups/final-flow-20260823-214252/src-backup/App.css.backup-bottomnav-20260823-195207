  width: 62%;
  height: 112%;
  background: url("/players/batzo-player-hero.svg") center bottom / contain no-repeat;
  opacity: 1;
  z-index: 1;
  pointer-events: none;
  filter: saturate(1.15) contrast(1.08);
}

.hero::before {
  z-index: 0;
}

.hero > * {
  position: relative;
  z-index: 3;
}

.hero h1,
.hero p,
.hero button,
.hero .hero-button {
  position: relative;
  z-index: 4;
}

/* Hero text stays readable over player */
.hero h1 {
  max-width: 62%;
  text-shadow: 0 8px 30px rgba(0,0,0,.55);
}

.hero p {
  max-width: 58%;
  text-shadow: 0 4px 16px rgba(0,0,0,.65);
}

/* LIVE badge stays inside match card and lower than top header */
.cinematic-match-card .live-dot,
.live-match-card .live-dot {
  position: relative;
  z-index: 20;
}

.live-match-card::before {
  top: 22px;
  right: 18px;
  z-index: 25;
}

/* Match card content never gets covered */
.cinematic-match-card .match-top,
.cinematic-match-card .teams,
.cinematic-match-card .match-meta,
.cinematic-match-card .match-bottom {
  position: relative;
  z-index: 10;
}

/* Full-width premium live match */
.live-match-card {
  overflow: hidden;
}

/* Bottom navigation is always inside the viewport */
.bottom-nav,
.bottom-navigation,
nav.bottom-nav {
  position: fixed;
  left: 12px;
  right: 12px;
  bottom: max(8px, env(safe-area-inset-bottom, 0px));
  width: auto;
  z-index: 999;
  padding-bottom: max(4px, env(safe-area-inset-bottom, 0px));
  background: rgba(5,9,14,.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 24px;
  box-shadow:
    0 -8px 30px rgba(0,0,0,.42),
    inset 0 1px 0 rgba(255,255,255,.05);
}

/* Prevent Android navigation bar from covering app */
.page {
  padding-bottom: 110px;
}

/* Mobile final composition */
@media (max-width: 430px) {

  .hero {
    min-height: 370px;
    border-radius: 28px;
  }

  .hero::after {
    right: -32px;
    bottom: -28px;
    width: 69%;
    height: 112%;
    opacity: 1;
  }

  .hero h1 {
    max-width: 70%;
    font-size: clamp(34px, 10vw, 48px);
    line-height: .98;
  }

  .hero p {
    max-width: 67%;
    font-size: 13px;
    line-height: 1.45;
  }

  .live-match-card::before {
    top: 18px;
    right: 14px;
  }

  .bottom-nav,
  .bottom-navigation,
  nav.bottom-nav {
    left: 10px;
    right: 10px;
    bottom: max(6px, env(safe-area-inset-bottom, 0px));
    border-radius: 22px;
  }

  .page {
    padding-bottom: 112px;
  }
}

/* very small screens */
@media (max-width: 360px) {

  .hero {
    min-height: 350px;
  }

  .hero::after {
    right: -38px;
    width: 72%;
  }

  .hero h1 {
    max-width: 68%;
    font-size: 34px;
  }

  .hero p {
    max-width: 64%;
    font-size: 12px;
  }
}

