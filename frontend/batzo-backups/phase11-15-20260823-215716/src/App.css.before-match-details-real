:root {
  --bg: #050a0f;
  --card: #0c2024;
  --card2: #10282c;
  --line: #203c41;
  --text: #f5f7f8;
  --muted: #91a4aa;
  --green: #D9A62E;
  --purple: #8c5cff;
  --orange: #ff9d21;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100%;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  overflow-x: hidden;
  -webkit-text-size-adjust: 100%;
}

button {
  font: inherit;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.app-shell {
  min-height: 100vh;
  width: 100%;
  padding-bottom: 82px;
  background:
    radial-gradient(circle at 50% -10%, rgba(38, 122, 133, .18), transparent 35%),
    var(--bg);
}

.top-header {
  height: 76px;
  padding: 8px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(5, 10, 15, .96);
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand {
  width: 68%;
  max-width: 300px;
}

.batzo-logo {
  display: block;
  width: 100%;
  max-width: 285px;
  height: 58px;
  object-fit: contain;
  object-position: left center;
}

.header-actions {
  display: flex;
  gap: 8px;
}

.header-btn {
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 12px;
  background: #10242a;
  color: white;
  font-size: 20px;
}

.home-page,
.page {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 14px;
}

.hero-card {
  border: 1px solid #24464b;
  border-radius: 28px;
  background: linear-gradient(145deg, #0c282b, #09171b);
  padding: 25px 20px;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0,0,0,.28);
}

.eyebrow,
.section-heading span,
.reward-card > span {
  color: var(--green);
  font-weight: 800;
  letter-spacing: .8px;
  font-size: 14px;
}

.hero-card h1 {
  margin: 22px 0 14px;
  font-size: clamp(38px, 10vw, 68px);
  line-height: .98;
  letter-spacing: -2px;
}

.hero-card h1 span {
  background: linear-gradient(90deg, #1ff0ae, #9c62ff, #ff50b5);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-card p {
  margin: 0 0 20px;
  color: var(--muted);
  font-size: 17px;
  line-height: 1.5;
}

.hero-buttons {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
}

.primary-btn,
.secondary-btn,
.link-btn,
.match-bottom button,
.entry-btn {
  border: 0;
  border-radius: 12px;
  padding: 12px 17px;
  font-weight: 800;
}

.primary-btn {
  color: #04100c;
  background: linear-gradient(135deg, #20e6a0, #7df3ca);
}

.secondary-btn {
  color: white;
  background: #142d32;
  border: 1px solid #2c5055;
}

.hero-score {
  margin-top: 22px;
  padding-top: 16px;
  border-top: 1px solid #24464b;
  display: flex;
  align-items: baseline;
  gap: 9px;
}

.hero-score span {
  color: var(--green);
  font-weight: 900;
}

.hero-score strong {
  font-size: 28px;
}

.hero-score small {
  color: var(--muted);
}

.section {
  margin-top: 25px;
}

.section-heading {
  margin-bottom: 13px;
}

.section-heading.row {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 10px;
}

.section-heading h2 {
  margin: 7px 0 0;
  font-size: clamp(25px, 7vw, 34px);
}

.link-btn {
  background: transparent;
  color: var(--green);
  padding: 5px;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.quick-card {
  min-width: 0;
  min-height: 112px;
  text-align: left;
  padding: 16px;
  border-radius: 18px;
  border: 1px solid var(--line);
  background: var(--card);
  color: white;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.quick-card b {
  font-size: 25px;
}

.quick-card strong {
  font-size: 16px;
}

.quick-card small {
  color: var(--muted);
}

.matches-list {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.match-card {
  border: 1px solid #24464b;
  border-radius: 25px;
  padding: 16px;
  background: linear-gradient(145deg, #0d2328, #0a181d);
  color: white;
  transition: transform .15s ease, border-color .15s ease;
  touch-action: manipulation;
}

.match-card:active {
  transform: scale(.985);
  border-color: var(--green);
}

.match-top,
.match-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.match-top > span:last-child {
  color: var(--green);
  font-size: 12px;
  font-weight: 800;
}

.status {
  font-size: 12px;
  font-weight: 900;
}

.status.live {
  color: #ff4f67;
}

.status.upcoming {
  color: var(--green);
}

.teams {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1fr);
  align-items: center;
  gap: 7px;
  margin: 25px 0;
}

.team {
  min-width: 0;
  text-align: center;
}

.team > span {
  display: inline-flex;
  min-width: 42px;
  height: 42px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #172f35;
  color: #fff;
  font-weight: 900;
  margin-bottom: 8px;
}

.team strong {
  display: block;
  font-size: clamp(18px, 5vw, 25px);
  line-height: 1.12;
  overflow-wrap: anywhere;
}

.team small {
  display: block;
  margin-top: 5px;
  color: var(--green);
  font-weight: 900;
}

.vs {
  color: var(--purple);
  text-align: center;
  font-size: 15px;
}

.match-bottom {
  border-top: 1px solid var(--line);
  padding-top: 13px;
  color: var(--muted);
  font-size: 13px;
}

.match-bottom button {
  background: white;
  color: #111;
  padding: 9px 12px;
}

.reward-card {
  margin-top: 25px;
  padding: 23px 20px;
  border: 1px solid #263e43;
  border-radius: 24px;
  background: linear-gradient(135deg, #12282c, #0b171b);
}

.reward-card h2 {
  font-size: clamp(28px, 8vw, 42px);
  line-height: 1.03;
  margin: 13px 0;
}

.reward-card p {
  color: var(--muted);
  line-height: 1.5;
  font-size: 16px;
}

.leader-row {
  display: grid;
  grid-template-columns: 28px 35px minmax(0, 1fr) auto;
  gap: 9px;
  align-items: center;
  padding: 13px 4px;
  border-bottom: 1px solid #182d31;
}

.leader-row > span {
  font-size: 23px;
}

.leader-row div {
  min-width: 0;
}

.leader-row strong,
.leader-row small {
  display: block;
}

.leader-row small {
  color: var(--muted);
  margin-top: 3px;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 72px;
  z-index: 50;
  background: rgba(7, 15, 19, .97);
  border-top: 1px solid #21383d;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  padding-bottom: env(safe-area-inset-bottom);
}

.bottom-nav button {
  border: 0;
  background: transparent;
  color: #9badb2;
  font-size: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
}

.bottom-nav small {
  font-size: 10px;
}

.bottom-nav .nav-play {
  width: 52px;
  height: 52px;
  margin: auto;
  border-radius: 50%;
  color: #06110d;
  background: linear-gradient(135deg, #1fe7a2, #8d61ff);
}

.page {
  padding-top: 20px;
}

.page-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.page-header button {
  width: 43px;
  height: 43px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--card);
  color: white;
  font-size: 22px;
}

.page-header h1 {
  margin: 0;
  font-size: clamp(24px, 7vw, 35px);
}

.detail-card,
.success-card,
.team-summary,
.captain-info {
  padding: 20px;
  border-radius: 22px;
  border: 1px solid var(--line);
  background: var(--card);
  margin-bottom: 18px;
}

.detail-card h2 {
  text-align: center;
  font-size: 27px;
  margin: 15px 0;
}

.detail-card p {
  text-align: center;
  color: var(--muted);
}

.vs-large {
  text-align: center;
  color: var(--purple);
  font-weight: 900;
}

.sub-title {
  font-size: 22px;
}

.contest-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.contest-card {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 12px;
  text-align: left;
  color: white;
  padding: 17px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--card);
}

.contest-card div {
  min-width: 0;
}

.contest-card strong,
.contest-card small {
  display: block;
}

.contest-card small {
  color: var(--muted);
  margin-top: 5px;
}

.entry-btn {
  background: var(--green);
  color: #06110d;
}

.team-progress {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 14px;
  margin-bottom: 12px;
  border-radius: 15px;
  background: var(--card);
}

.team-progress span {
  color: var(--muted);
}

.player-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.player-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
  padding: 13px;
  border: 1px solid var(--line);
  border-radius: 15px;
  background: var(--card);
  color: white;
}

.player-card > span {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #172f35;
  color: var(--green);
  font-weight: 900;
}

.player-card div {
  min-width: 0;
}

.player-card strong,
.player-card small {
  display: block;
}

.player-card small {
  color: var(--muted);
  margin-top: 3px;
}

.player-card.selected {
  border-color: var(--green);
  background: #0e2926;
}

.sticky-action {
  width: 100%;
  margin-top: 16px;
  margin-bottom: 15px;
}

.captain-info strong,
.captain-info small {
  display: block;
}

.captain-info small {
  color: var(--muted);
  margin-top: 6px;
}

.captain-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 13px;
  margin-bottom: 8px;
  border: 1px solid var(--line);
  border-radius: 15px;
  background: var(--card);
}

.captain-row div:first-child {
  min-width: 0;
}

.captain-row strong,
.captain-row small {
  display: block;
}

.captain-row small {
  color: var(--muted);
}

.captain-buttons {
  display: flex;
  gap: 6px;
}

.captain-buttons button {
  width: 43px;
  height: 43px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #172f35;
  color: white;
  font-weight: 900;
}

.captain-buttons .active-c {
  background: #ffbd35;
  color: #111;
}

.captain-buttons .active-vc {
  background: var(--purple);
  color: white;
}

.success-card {
  text-align: center;
}

.success-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 12px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--green);
  color: #06110d;
  font-size: 35px;
  font-weight: 900;
}

.success-card p {
  color: var(--muted);
}

.team-summary {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.team-summary div {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.team-summary span {
  color: var(--muted);
}

.team-summary strong {
  text-align: right;
}

.leaderboard-table {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 18px;
  margin-bottom: 18px;
}

.lb-head,
.lb-row {
  display: grid;
  grid-template-columns: 55px minmax(0, 1fr) 75px;
  gap: 8px;
  padding: 14px;
  align-items: center;
}

.lb-head {
  color: var(--muted);
  background: #102328;
}

.lb-row {
  border-top: 1px solid var(--line);
}

.lb-row:nth-child(5) {
  background: #10332d;
  color: var(--green);
}

@media (max-width: 430px) {
  .home-page,
  .page {
    padding-left: 11px;
    padding-right: 11px;
  }

  .top-header {
    height: 68px;
  }

  .batzo-logo {
    height: 52px;
  }

  .hero-card {
    padding: 20px 16px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-buttons button {
    width: 100%;
  }

  .teams {
    grid-template-columns: minmax(0, 1fr) 35px minmax(0, 1fr);
  }

  .team strong {
    font-size: 18px;
  }

  .contest-card {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .entry-btn {
    grid-column: 1 / -1;
    text-align: center;
  }
}

