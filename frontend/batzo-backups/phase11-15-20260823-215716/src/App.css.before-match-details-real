  min-height: 50px !important;
  padding: 8px !important;
}

.player-card > span {
  width: 27px !important;
  height: 27px !important;
  font-size: 11px !important;
}

.player-card strong {
  font-size: 12px !important;
}

.player-card small {
  font-size: 9px !important;
}

/* Captain / VC */
.captain-info {
  padding: 12px !important;
}

.captain-info strong {
  font-size: 13px !important;
}

.captain-info small {
  font-size: 10px !important;
}

.captain-row {
  min-height: 52px !important;
}

.captain-row strong {
  font-size: 12px !important;
}

.captain-row small {
  font-size: 9px !important;
}

.captain-buttons button {
  width: 32px !important;
  height: 32px !important;
  font-size: 10px !important;
}

/* General buttons */
.primary-btn,
.secondary-btn,
.sticky-action,
.entry-btn {
  font-size: 11px !important;
  padding: 8px 11px !important;
}

/* Page titles */
.page-header h1 {
  font-size: 21px !important;
}

.page-header p {
  font-size: 11px !important;
}

.detail-card h2 {
  font-size: 19px !important;
}

.detail-card p {
  font-size: 11px !important;
}

/* My Contest */
.success-card {
  padding: 14px !important;
}

.success-card h2 {
  font-size: 18px !important;
}

.success-card p {
  font-size: 11px !important;
}

.team-summary {
  font-size: 11px !important;
}

.team-summary strong {
  font-size: 11px !important;
}

/* Bottom navigation */
.bottom-nav {
  height: 62px !important;
}

.bottom-nav button {
  font-size: 15px !important;
}

.bottom-nav small {
  font-size: 8px !important;
}

/* Android small screen */
@media (max-width: 430px) {

  .home-page,
  .page {
    padding-left: 10px !important;
    padding-right: 10px !important;
  }

  .top-header {
    height: 55px !important;
    padding: 5px 10px !important;
  }

  .batzo-logo {
    height: 42px !important;
  }

  .hero-card {
    padding: 14px !important;
    border-radius: 18px !important;
  }

  .hero-card h1 {
    font-size: 29px !important;
  }

  .hero-card p {
    font-size: 12px !important;
  }

  .team strong {
    font-size: 14px !important;
  }

  .reward-card h2 {
    font-size: 22px !important;
  }

  .section-heading h2 {
    font-size: 19px !important;
  }
}

html,body,#root{width:100%;min-height:100%;margin:0;padding:0}
body{background:#05090b;overflow-x:hidden;-webkit-tap-highlight-color:transparent}
*{box-sizing:border-box}
button,a{-webkit-tap-highlight-color:transparent}

.app,.app-container,.main-app,.home-page,.page,main{
  padding-bottom:max(86px,calc(70px + env(safe-area-inset-bottom)));
}

.bottom-nav,.bottom-navigation,.navbar-bottom,.mobile-bottom-nav{
  position:fixed!important;
  left:0!important;
  right:0!important;
  bottom:0!important;
  z-index:9999!important;
  min-height:70px;
  padding-bottom:max(8px,env(safe-area-inset-bottom))!important;
  background:rgba(5,12,15,.96)!important;
  border-top:1px solid rgba(65,220,180,.18)!important;
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
}

.bottom-nav button,.bottom-nav a,
.bottom-navigation button,.bottom-navigation a,
.navbar-bottom button,.navbar-bottom a,
.mobile-bottom-nav button,.mobile-bottom-nav a{
  min-height:58px;
  color:rgba(255,255,255,.68);
  transition:transform .18s ease,color .18s ease;
}

.bottom-nav button:active,.bottom-nav a:active,
.bottom-navigation button:active,.bottom-navigation a:active{
  transform:scale(.94);
}

.bottom-nav .active,.bottom-navigation .active,
.navbar-bottom .active,.mobile-bottom-nav .active{
  color:#F5B942!important;
}

.nav-play,.play-button,.center-play,.bottom-nav .nav-play{
  width:64px!important;
  height:64px!important;
  min-width:64px!important;
  border-radius:50%!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  background:linear-gradient(135deg,#27e5aa,#7c5cff)!important;
  box-shadow:0 8px 28px rgba(39,229,170,.28)!important;
  border:2px solid rgba(255,255,255,.18)!important;
  transform:translateY(-12px);
}

.match-card,.match-item,.match-row,.game-card,.fixture-card{
  border:1px solid rgba(84,213,190,.18)!important;
  background:linear-gradient(145deg,rgba(14,35,39,.98),rgba(7,20,23,.98))!important;
  box-shadow:0 12px 35px rgba(0,0,0,.18);
  overflow:hidden;
}

.match-card button,.match-item button,.game-card button,.fixture-card button{
  touch-action:manipulation;
}

.join-btn,.join-now,button[class*="join"]{
  min-height:44px;
  border-radius:24px!important;
  font-weight:800!important;
}

#root,.app,.app-container{
  max-width:100vw;
  overflow-x:hidden;
}

button{
  touch-action:manipulation;
}

button,.match-card,.game-card,.bottom-nav{
  user-select:none;
}

@media(max-width:600px){
  body{font-size:15px}
  .match-card,.game-card,.fixture-card{
    border-radius:22px!important;
  }
}


/* ============================================================
   BATZO REAL MATCHES + CONTESTS
   ============================================================ */

.real-matches-page{
  width:100%;
  padding:20px 18px 110px;
}

.real-page-heading{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:18px;
}

.real-page-heading span{
  color:#F5B942;
  font-size:13px;
  font-weight:900;
  letter-spacing:.12em;
}

.real-page-heading h1{
  margin:5px 0 0;
  color:#fff;
  font-size:30px;
}

.real-refresh{
  border:1px solid rgba(53,230,173,.25);
  background:#10272b;
  color:#F5B942;
  border-radius:18px;
  padding:10px 13px;
  font-weight:800;
}

.real-match-tabs{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding-bottom:10px;
  margin-bottom:10px;
}

.real-match-tabs button{
  flex:0 0 auto;
  border:1px solid rgba(255,255,255,.12);
  background:#0d2024;
  color:#9aa9ac;
  border-radius:20px;
  padding:10px 16px;
  font-weight:800;
}

.real-match-tabs button.active{
  background:#F5B942;
  color:#04100d;
  border-color:#F5B942;
}

.real-match-list{
  display:flex;
  flex-direction:column;
  gap:14px;
}

.real-match-card{
  width:100%;
  text-align:left;
  border:1px solid rgba(84,213,190,.18);
  background:linear-gradient(145deg,#102b30,#071518);
  border-radius:22px;
  padding:17px;
  color:#fff;
  box-shadow:0 12px 35px rgba(0,0,0,.22);
}

.real-match-card:active{
  transform:scale(.985);
}

.real-match-top{
  display:flex;
  justify-content:space-between;
  color:#7f9296;
  font-size:12px;
  font-weight:900;
}

.real-live{
  color:#ff5575;
}

.real-status{
  color:#F5B942;
}

.real-series{
  margin:12px 0;
  color:#c5d0d2;
  font-size:13px;
  font-weight:700;
}

.real-teams{
  display:grid;
  grid-template-columns:1fr 45px 1fr;
  align-items:center;
  gap:8px;
  text-align:center;
}

.real-teams div{
  display:flex;
  flex-direction:column;
  gap:7px;
}

.real-teams strong{
  font-size:17px;
}

.real-teams small{
  color:#F5B942;
  font-weight:800;
}

.real-teams b{
  color:#8a5cff;
}

.real-match-status{
  margin-top:15px;
  padding-top:13px;
  border-top:1px solid rgba(255,255,255,.1);
  color:#9aa9ac;
  font-size:13px;
}

.real-match-action{
  display:flex;
  justify-content:space-between;
  margin-top:14px;
  color:#F5B942;
  font-weight:900;
}

.real-details{
  padding:20px 18px 110px;
}

.real-back{
  border:0;
  background:transparent;
  color:#F5B942;
  padding:8px 0 18px;
  font-weight:900;
}

.real-details-card{
  background:linear-gradient(145deg,#102b30,#071518);
  border:1px solid rgba(84,213,190,.18);
  border-radius:24px;
  padding:20px;
}

.real-details-card h2{
  color:#fff;
  font-size:21px;
  margin:10px 0;
}

.real-details-card p{
  color:#95a7aa;
  margin:7px 0;
}

.real-details-status{
  color:#F5B942;
  font-weight:900;
}

.real-details-teams{
  display:grid;
  grid-template-columns:1fr 40px 1fr;
  text-align:center;
  align-items:center;
  gap:8px;
  margin:20px 0;
  color:#fff;
  font-size:18px;
  font-weight:900;
}

.real-details-teams b{
  color:#8a5cff;
}

.real-tabs{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  margin:16px 0;
}

.real-tabs button{
  border:1px solid rgba(255,255,255,.1);
  background:#0d2024;
  color:#9aa9ac;
  padding:12px 5px;
  border-radius:15px;
  font-weight:800;
}

.real-tabs button.active{
  background:#F5B942;
  color:#04100d;
}

.contest-list{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.contest-card{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  background:#0d2024;
  border:1px solid rgba(84,213,190,.16);
  border-radius:20px;
  padding:16px;
}

.contest-card div{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.contest-card strong{
  color:#fff;
}

.contest-card small{
  color:#91a3a6;
}

.contest-card button{
  flex:0 0 auto;
  border:0;
  background:#F5B942;
  color:#04100d;
  border-radius:18px;
  padding:11px 13px;
  font-weight:900;
}

.real-data-box{
  background:#09191c;
  border:1px solid rgba(84,213,190,.14);
  border-radius:20px;
  padding:16px;
  color:#a9b9bb;
  overflow:auto;
}

.real-data-box pre{
  white-space:pre-wrap;
  word-break:break-word;
  font-size:11px;
}

.real-loading,
.real-empty,
.real-error{
  text-align:center;
  padding:35px 15px;
  color:#9aa9ac;
}

.real-loading p,
.real-empty p,
.real-error p{
  margin:10px 0;
}

.real-empty h3{
  color:#fff;
}

.real-error strong{
  color:#ff647f;
}

.real-error button{
  margin-top:12px;
  border:0;
  background:#F5B942;
  color:#04100d;
  border-radius:18px;
  padding:11px 18px;
  font-weight:900;
}

.real-spinner{
  width:34px;
  height:34px;
  margin:auto;
  border:3px solid rgba(255,255,255,.12);
  border-top-color:#F5B942;
  border-radius:50%;
  animation:batzo-spin .8s linear infinite;
}

@keyframes batzo-spin{
  to{transform:rotate(360deg)}
}


/* ==================================================
   BATZO MATCH DETAILS
   ================================================== */

.batzo-match-details {
  min-height: 100vh;
  padding: 24px 20px 130px;
  background: #080d12;
  color: #f8fafc;
}

.batzo-details-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
}

.batzo-details-header span {
  color: #f5bd43;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.batzo-details-header h1 {
  margin: 3px 0 0;
  font-size: 28px;
}

.batzo-details-back {
  width: 54px;
  height: 54px;
  border: 1px solid rgba(83, 207, 200, .25);
  border-radius: 18px;
  background: #102329;
  color: #fff;
  font-size: 30px;
}

.batzo-details-hero {
  padding: 24px 18px;
  border-radius: 28px;
  text-align: center;
  background: linear-gradient(145deg, #0c282b, #0b151b);
  border: 1px solid rgba(80, 210, 202, .28);
  box-shadow: 0 18px 50px rgba(0,0,0,.25);
}

.batzo-details-status {
  display: inline-flex;
  padding: 8px 15px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 900;
  margin-bottom: 12px;
}

.batzo-details-status.upcoming {
  background: rgba(245,189,67,.16);
  color: #f5bd43;
}

.batzo-details-status.live {
  background: rgba(255,75,75,.16);
  color: #ff7777;
}

.batzo-details-status.completed {
  background: rgba(150,160,170,.15);
  color: #c0c7ce;
}

.batzo-details-hero h2 {
  margin: 7px 0 22px;
  font-size: 21px;
}

.batzo-details-teams {
  display: grid;
  grid-template-columns: 1fr 55px 1fr;
  align-items: center;
  gap: 8px;
}

.batzo-details-team {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.batzo-team-circle {
  width: 68px;
  height: 68px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #142b31;
  border: 1px solid rgba(255,255,255,.08);
  font-size: 18px;
  font-weight: 900;
}

.batzo-details-team strong {
  font-size: 14px;
}

.batzo-details-vs {
  color: #a76aff;
  font-size: 18px;
  font-weight: 1000;
}

.batzo-details-status-text {
  margin: 18px 0 0;
  color: #aab5bf;
  line-height: 1.5;
}

.batzo-details-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 15px;
}

.batzo-info-card {
  padding: 16px;
  border-radius: 18px;
  background: #10191f;
  border: 1px solid rgba(255,255,255,.07);
}

.batzo-info-card span,
.batzo-card-kicker {
  display: block;
  color: #f5bd43;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .5px;
}

.batzo-info-card strong {
  display: block;
  margin-top: 7px;
  font-size: 13px;
  line-height: 1.45;
}

.batzo-details-card {
  margin-top: 15px;
  padding: 20px;
  border-radius: 24px;
  background: #0e171d;
  border: 1px solid rgba(255,255,255,.07);
}

.batzo-details-card h3 {
  margin: 7px 0 10px;
  font-size: 21px;
}

.batzo-details-card > p {
  color: #9da8b3;
  line-height: 1.55;
}

.batzo-details-actions {
  display: grid;
  gap: 10px;
  margin-top: 18px;
}

.batzo-create-team-btn,
.batzo-contests-btn {
  min-height: 53px;
  border-radius: 16px;
  font-size: 14px;
  font-weight: 900;
}

.batzo-create-team-btn {
  border: 0;
  background: linear-gradient(135deg, #ffd86a, #e7a91e);
  color: #111;
}

.batzo-contests-btn {
  border: 1px solid rgba(245,189,67,.28);
  background: #12262c;
  color: #f5bd43;
}

.batzo-player-box {
  margin-top: 14px;
  padding: 20px 15px;
  text-align: center;
  border-radius: 18px;
  background: #101d23;
}

.batzo-player-icon {
  font-size: 30px;
}

.batzo-player-box strong {
  display: block;
  margin-top: 7px;
}

.batzo-player-box p {
  margin-bottom: 0;
  font-size: 13px;
  color: #9da8b3;
  line-height: 1.5;
}

@media (max-width: 380px) {
  .batzo-details-info-grid {
    grid-template-columns: 1fr;
  }

  .batzo-details-teams {
    grid-template-columns: 1fr 42px 1fr;
  }
}

/* ==================================================
   END BATZO MATCH DETAILS
   ================================================== */
