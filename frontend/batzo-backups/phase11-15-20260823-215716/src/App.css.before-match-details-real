}

.reward-card > span {
  font-size: 10px !important;
}

.reward-card h2 {
  font-size: 23px !important;
  line-height: 1.12 !important;
  margin: 7px 0 !important;
}

.reward-card p {
  font-size: 12px !important;
  line-height: 1.4 !important;
}

.reward-card button {
  font-size: 11px !important;
  padding: 7px 10px !important;
