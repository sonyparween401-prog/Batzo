:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f4f7fb;
  background: #070b11;
  font-synthesis: none;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  min-width: 320px;
  background: #070b11;
}

button {
  font: inherit;
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% -10%, rgba(33,230,138,.12), transparent 35%),
    #070b11;
  color: #f4f7fb;
  padding-bottom: 82px;
}

.home-header,
.topbar {
  min-height: 72px;
  padding: 15px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(7,11,17,.96);
  border-bottom: 1px solid rgba(255,255,255,.06);
}

.brand {
  font-size: 30px;
  line-height: 28px;
  font-weight: 1000;
  letter-spacing: -1.5px;
  color: #21e68a;
}

.tagline,
.brand-small,
.small-label {
  color: #718096;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.profile-button,
.back-button {
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 14px;
  color: #21e68a;
  background: #111923;
  font-weight: 900;
}

.topbar {
  justify-content: flex-start;
  gap: 13px;
}

.topbar-title {
  margin-top: 2px;
  font-size: 16px;
  font-weight: 900;
}

.live-dot,
.green-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #21e68a;
  margin-left: auto;
  box-shadow: 0 0 12px rgba(33,230,138,.7);
}

.page {
  width: min(100%, 680px);
  margin: 0 auto;
  padding: 18px 15px 28px;
}

.hero {
  padding: 24px 20px;
  border-radius: 25px;
  border: 1px solid rgba(33,230,138,.15);
  background:
    linear-gradient(135deg, rgba(33,230,138,.13), rgba(14,22,34,.96) 55%),
    #0e1622;
  box-shadow: 0 18px 50px rgba(0,0,0,.25);
}

.hero-kicker {
  color: #21e68a;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1px;
}

.hero h1 {
  margin: 14px 0 8px;
  font-size: clamp(34px, 10vw, 52px);
  line-height: .98;
  letter-spacing: -2px;
}

.hero h1 span {
  color: #21e68a;
}

.hero p {
  color: #8b98aa;
  margin: 0 0 20px;
}

.hero-button,
.primary-action {
  border: 0;
  border-radius: 14px;
  padding: 14px 17px;
  background: #21e68a;
  color: #06110b;
  font-weight: 1000;
  width: 100%;
}

.section-title {
  margin: 23px 2px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title h1,
.section-title h2 {
  margin: 4px 0 0;
  font-size: 23px;
}

.view-all {
  border: 0;
  background: transparent;
  color: #21e68a;
  font-weight: 900;
}

.count-badge {
  background: rgba(33,230,138,.1);
  color: #21e68a;
  border-radius: 12px;
  padding: 8px 11px;
  font-weight: 900;
}

.matches-list {
  display: grid;
  gap: 12px;
}

.match-card {
  width: 100%;
  text-align: left;
  color: inherit;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 20px;
  padding: 15px;
  background: linear-gradient(145deg, #111a25, #0c131c);
  box-shadow: 0 10px 28px rgba(0,0,0,.2);
  transition: transform .15s ease, border-color .15s ease;
}

.match-card:active {
  transform: scale(.985);
}

.match-card:hover {
  border-color: rgba(33,230,138,.25);
}

.match-card-top,
.card-footer,
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.live-pill,
.upcoming-pill {
  display: inline-block;
  padding: 6px 9px;
  border-radius: 8px;
  font-size: 9px;
  font-weight: 1000;
}

.live-pill {
  background: rgba(255,70,70,.12);
  color: #ff7777;
}

.upcoming-pill {
  background: rgba(33,230,138,.1);
  color: #21e68a;
}

.large {
  font-size: 10px;
}

.match-time {
  color: #7e8b9d;
  font-size: 11px;
  font-weight: 800;
}

.teams-row,
.details-teams {
  display: grid;
  grid-template-columns: 1fr 42px 1fr;
  align-items: center;
  text-align: center;
  gap: 5px;
  margin: 18px 0 12px;
}

.team-block {
  min-width: 0;
}

.team-badge {
  width: 48px;
  height: 48px;
  margin: 0 auto 8px;
  border-radius: 15px;
  display: grid;
  place-items: center;
  background: #182433;
  border: 1px solid rgba(33,230,138,.16);
  color: #21e68a;
  font-weight: 1000;
}

.team-name {
  font-size: 12px;
  color: #dce3eb;
  font-weight: 800;
  line-height: 1.25;
}

.team-score {
  margin-top: 5px;
  font-size: 17px;
  font-weight: 1000;
}

.versus,
.details-vs {
  color: #58677a;
  font-size: 10px;
  font-weight: 1000;
}

.match-result {
  margin: 12px 0;
  padding: 9px 10px;
  border-radius: 10px;
  background: rgba(255,255,255,.035);
  color: #9ba8b8;
  font-size: 11px;
  text-align: center;
}

.card-footer {
  padding-top: 11px;
  border-top: 1px solid rgba(255,255,255,.05);
  color: #7f8c9c;
  font-size: 10px;
}

.card-footer strong {
  color: #21e68a;
}

.quick-grid,
.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 15px;
}

.action-grid {
  grid-template-columns: repeat(2, 1fr);
}

.quick-grid button,
.action-grid button {
  min-height: 82px;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 15px;
  background: #0e1622;
  color: #dce3eb;
  text-align: left;
  padding: 12px;
}

.quick-grid span,
.action-grid span {
  display: block;
  font-size: 20px;
  margin-bottom: 7px;
}

.quick-grid b,
.action-grid b {
  display: block;
  font-size: 10px;
}

.quick-grid small,
.action-grid small {
  color: #718096;
  font-size: 9px;
}

.details-page {
  padding-top: 12px;
}

.details-hero {
  padding: 18px 14px;
  text-align: center;
  border-radius: 22px;
  background: linear-gradient(145deg, #111c29, #0b121b);
  border: 1px solid rgba(255,255,255,.06);
}

.details-teams {
  margin: 22px 0 10px;
}

.details-teams h2 {
  font-size: 14px;
  line-height: 1.25;
}

.big-score {
  font-size: 20px;
  font-weight: 1000;
}

.details-result {
  margin: 15px 0 0;
  color: #21e68a;
  font-size: 12px;
  font-weight: 800;
}

.content-panel {
  margin-top: 14px;
  padding: 16px;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 20px;
  background: #0d151f;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.panel-heading h3 {
  margin: 4px 0 0;
  font-size: 19px;
}

.panel-icon {
  font-size: 26px;
}

.info-row {
  padding: 13px 0;
  border-top: 1px solid rgba(255,255,255,.05);
  color: #8d9aac;
  font-size: 11px;
}

.info-row strong {
  color: #e7edf4;
  text-align: right;
  max-width: 58%;
}

.primary-action {
  margin: 4px 0 12px;
}

.contest-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 13px;
  margin-bottom: 9px;
  border-radius: 13px;
  background: #111b27;
}

.contest-item b,
.contest-item small {
  display: block;
}

.contest-item small {
  margin-top: 4px;
  color: #718096;
  font-size: 10px;
}

.contest-item button {
  border: 0;
  border-radius: 9px;
  padding: 9px 13px;
  background: #21e68a;
  color: #06110b;
  font-size: 10px;
  font-weight: 1000;
}

.empty-state {
  text-align: center;
  padding: 18px 5px;
}

.empty-state > div {
  font-size: 42px;
}

.empty-state p,
.muted {
  color: #718096;
  font-size: 12px;
}

.score-board {
  display: grid;
  gap: 8px;
}

.score-board div {
  display: flex;
  justify-content: space-between;
  padding: 14px;
  border-radius: 12px;
  background: #111b27;
}

.score-board strong {
  color: #21e68a;
}

.home-back {
  width: 100%;
  margin-top: 14px;
  padding: 14px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 14px;
  background: #111923;
  color: #21e68a;
  font-weight: 900;
}

.profile-panel {
  padding: 22px;
  border-radius: 22px;
  background: #0e1622;
  border: 1px solid rgba(255,255,255,.06);
}

.profile-panel h1 {
  margin-bottom: 5px;
}

.profile-panel p {
  color: #718096;
  margin-bottom: 20px;
}

.bottom-nav {
  position: fixed;
  z-index: 9999;
  left: 10px;
  right: 10px;
  bottom: 10px;
  height: 66px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 5px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 19px;
  background: rgba(13,21,31,.98);
  box-shadow: 0 12px 35px rgba(0,0,0,.45);
}

.bottom-nav button {
  border: 0;
  border-radius: 14px;
  background: transparent;
  color: #647286;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 2px;
}

.bottom-nav button.active {
  background: rgba(33,230,138,.1);
  color: #21e68a;
}

.bottom-nav span {
  font-size: 20px;
  line-height: 20px;
}

.bottom-nav small {
  font-size: 8px;
  font-weight: 900;
}

@media (min-width: 600px) {
  .page {
    padding-left: 20px;
    padding-right: 20px;
  }
}

/* ============================================================
   BATZO PREMIUM COLOURFUL THEME
   VISUAL ONLY — MATCH FLOW PRESERVED
   ============================================================ */

:root {
  --batzo-green: #20e68a;
  --batzo-cyan: #19d9ff;
  --batzo-blue: #5875ff;
  --batzo-purple: #a855f7;
  --batzo-pink: #ff3cac;
  --batzo-orange: #ff9d00;
  --batzo-yellow: #ffd43b;
}

/* Premium colourful headings */
h1,
h2,
h3 {
  background: linear-gradient(
    100deg,
    #ffffff 0%,
    #20e68a 22%,
    #19d9ff 42%,
    #8b5cf6 64%,
    #ff3cac 82%,
    #ff9d00 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Main hero heading gets stronger gaming gradient */
.hero h1,
.hero-title,
.hero h1 span,
.hero-title span,
[class*="hero"] h1,
[class*="hero"] h1 span {
  background: linear-gradient(
    105deg,
    #ffffff 0%,
    #20e68a 25%,
    #19d9ff 43%,
    #8b5cf6 62%,
    #ff3cac 80%,
    #ff9d00 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Accent labels */
.small-label,
.section-label,
[class*="label"] {
  color: #ffd43b !important;
  letter-spacing: 2px;
}

/* View All / links */
.view-all,
[class*="view-all"] {
  color: #20e68a !important;
  text-shadow:
    0 0 10px rgba(32,230,138,.28),
    0 0 20px rgba(25,217,255,.12);
}

/* Main action buttons */
button {
  transition:
    transform .18s ease,
    box-shadow .18s ease,
    filter .18s ease;
}

button:hover {
  transform: translateY(-1px);
}

button:active {
  transform: scale(.98);
}

/* Primary green buttons */
button[style*="#21e68a"],
button[style*="rgb(33, 230, 138)"] {
  background: linear-gradient(
    100deg,
    #20e68a,
    #19d9ff,
    #5875ff
  ) !important;
  box-shadow:
    0 8px 25px rgba(32,230,138,.25),
    0 0 25px rgba(25,217,255,.12);
}

/* Match cards — colourful premium border */
.match-card {
  border-color: rgba(32,230,138,.28) !important;
  box-shadow:
    0 0 0 1px rgba(25,217,255,.05),
    0 12px 35px rgba(0,0,0,.18);
}

/* Match team names */
.match-card h3,
.match-card h4,
.match-card strong {
  background: linear-gradient(
    90deg,
    #20e68a,
    #19d9ff,
    #a855f7
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Live badge */
.live,
[class*="live"] {
  text-shadow: 0 0 12px rgba(255,80,100,.35);
}

/* Quick access cards */
.quick-access-card,
[class*="quick"] .card,
[class*="quick"] > div {
  transition: transform .18s ease, box-shadow .18s ease;
}

.quick-access-card:active,
[class*="quick"] .card:active,
[class*="quick"] > div:active {
  transform: scale(.98);
}

/* Bottom navigation accent */
.bottom-nav button.active,
.bottom-nav .active {
  color: #20e68a !important;
  text-shadow: 0 0 14px rgba(32,230,138,.28);
}

/* BATZO brand text if text logo is present */
.logo,
.brand,
.brand-name,
[class*="logo"] {
  background: linear-gradient(
    90deg,
    #20e68a,
    #19d9ff,
    #8b5cf6,
    #ff3cac,
    #ff9d00
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Safe mobile rendering */
html,
body,
#root {
  min-height: 100%;
}

/* Prevent accidental invisible text from the theme */
p,
span,
label {
  -webkit-text-fill-color: initial;
}

/* Restore heading gradient after generic span rule */
h1,
h2,
h3,
.hero h1,
.hero h1 span,
.hero-title,
.hero-title span,
[class*="hero"] h1,
[class*="hero"] h1 span {
  -webkit-text-fill-color: transparent;
}

/* ============================================================
   END BATZO PREMIUM COLOURFUL THEME
   ============================================================ */

/* ============================================================
   BATZO DREAM11 STYLE MATCH UI
   VISUAL UPGRADE ONLY
   EXISTING MATCH FLOW PRESERVED
   ============================================================ */

.matches-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
}

.match-card {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: 220px;
  box-sizing: border-box;
  border-radius: 24px !important;
  border: 1px solid rgba(32,230,138,.24) !important;
  background:
    radial-gradient(circle at 15% 0%, rgba(32,230,138,.10), transparent 35%),
    radial-gradient(circle at 90% 20%, rgba(139,92,246,.10), transparent 32%),
    linear-gradient(145deg, #101923, #0b1119 65%, #10161f) !important;
  box-shadow:
    0 16px 40px rgba(0,0,0,.25),
    inset 0 1px 0 rgba(255,255,255,.05);
  cursor: pointer !important;
  pointer-events: auto !important;
  touch-action: manipulation;
  transition:
    transform .18s ease,
    border-color .18s ease,
    box-shadow .18s ease;
}

.match-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(
    180deg,
    #20e68a,
    #19d9ff,
    #8b5cf6,
    #ff3cac
  );
  opacity: .9;
}

.match-card:active {
  transform: scale(.985);
}

.match-card:hover {
  border-color: rgba(32,230,138,.45) !important;
  box-shadow:
    0 18px 45px rgba(0,0,0,.30),
    0 0 24px rgba(32,230,138,.08);
}

.match-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 18px 18px 8px;
}

.match-top span {
  font-weight: 800;
}

.match-card .live,
.match-card [class*="live"] {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 11px;
  border-radius: 999px;
  background: rgba(255,65,90,.12);
  color: #ff6b7d !important;
  font-size: 12px;
  font-weight: 900;
}

.match-card .match-top::after {
  content: "MATCH";
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  color: #8b98a9;
}

.match-card .team,
.match-card [class*="team"] {
  font-weight: 850;
}

.match-card h3,
.match-card h4 {
  font-weight: 900;
}

.match-card button {
  position: relative;
  z-index: 3;
  pointer-events: auto !important;
}

.match-card .match-bottom,
.match-card [class*="bottom"] {
  border-radius: 14px;
}

.view-all {
  font-weight: 900 !important;
}

/* Match section heading */
.matches-section h2,
.match-section h2,
[class*="matches"] h2 {
  letter-spacing: -.5px;
}

/* Contest/action cards */
.contest-card,
[class*="contest-card"] {
  border-radius: 20px;
  border: 1px solid rgba(32,230,138,.16);
  background:
    linear-gradient(145deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
  box-shadow: 0 10px 28px rgba(0,0,0,.18);
}

/* Premium green CTA */
.match-card .join,
.match-card .join-contest,
.match-card [class*="join"] {
  background: linear-gradient(
    100deg,
    #20e68a,
    #19d9ff
  ) !important;
  color: #06110b !important;
  border: 0 !important;
  font-weight: 900 !important;
  border-radius: 14px !important;
  box-shadow: 0 8px 22px rgba(32,230,138,.20);
}

/* Team abbreviation badges */
.match-card [class*="team-logo"],
.match-card [class*="team-badge"] {
  border: 1px solid rgba(25,217,255,.22);
  background: linear-gradient(
    145deg,
    rgba(32,230,138,.12),
    rgba(139,92,246,.12)
  );
}

/* Score emphasis */
.match-card [class*="score"] {
  font-weight: 950 !important;
}

/* Mobile spacing */
@media (max-width: 600px) {
  .matches-list {
    gap: 14px;
  }

  .match-card {
    min-height: 205px;
    border-radius: 22px !important;
  }

  .match-top {
    padding: 15px 15px 7px;
  }

  .match-card {
    -webkit-tap-highlight-color: transparent;
  }
}

/* ============================================================
   END DREAM11 STYLE MATCH UI
   ============================================================ */

/* ============================================================
   BATZO PREMIUM CONTEST UI
   ============================================================ */

.batzo-contest-page {
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  padding: 18px 16px 110px;
  background:
    radial-gradient(circle at 10% 0%, rgba(32,230,138,.12), transparent 32%),
    radial-gradient(circle at 100% 10%, rgba(139,92,246,.14), transparent 30%),
    linear-gradient(180deg, #071019 0%, #0a1119 55%, #071019 100%);
  color: #f7fbff;
}

.batzo-contest-header {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 8px 2px 20px;
}

.batzo-contest-header h1 {
  margin: 2px 0 0;
  font-size: 25px;
  font-weight: 950;
  letter-spacing: -.7px;
}

.batzo-contest-header p {
  margin: 3px 0 0;
  color: #8e9aaa;
  font-size: 12px;
  font-weight: 700;
}

.batzo-mini-brand {
  font-size: 11px;
  font-weight: 1000;
  letter-spacing: 3px;
  background: linear-gradient(
    90deg,
    #20e68a,
    #19d9ff,
    #8b5cf6,
    #ff3cac
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.batzo-contest-back {
  width: 43px;
  height: 43px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 14px;
  background: rgba(255,255,255,.055);
  color: #fff;
  font-size: 23px;
  font-weight: 900;
}

.batzo-contest-tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 2px 0 17px;
}

.batzo-contest-tabs button {
  flex: 0 0 auto;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 999px;
  padding: 9px 15px;
  background: rgba(255,255,255,.045);
  color: #8793a3;
  font-size: 11px;
  font-weight: 900;
}

.batzo-contest-tabs button.active {
  border-color: rgba(32,230,138,.4);
  background: linear-gradient(
    100deg,
    rgba(32,230,138,.18),
    rgba(25,217,255,.10)
  );
  color: #20e68a;
}

.batzo-contest-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.batzo-contest-card {
  position: relative;
  overflow: hidden;
  padding: 17px;
  border-radius: 22px;
  border: 1px solid rgba(255,255,255,.075);
  background:
    radial-gradient(circle at 100% 0%, rgba(139,92,246,.12), transparent 32%),
    linear-gradient(145deg, #111b26, #0d151e);
  box-shadow:
    0 14px 35px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.035);
  cursor: pointer;
  pointer-events: auto;
  touch-action: manipulation;
}

.batzo-contest-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 3px;
  height: 100%;
  background: linear-gradient(
    180deg,
    #20e68a,
    #19d9ff,
    #8b5cf6,
    #ff3cac
  );
}

.batzo-contest-card:active {
  transform: scale(.987);
}

.batzo-contest-card-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.batzo-contest-tag {
  display: inline-block;
  padding: 5px 8px;
  border-radius: 7px;
  background: rgba(32,230,138,.10);
  color: #20e68a;
  font-size: 9px;
  font-weight: 1000;
  letter-spacing: 1px;
}

.batzo-contest-card h3 {
  margin: 9px 0 0;
  font-size: 16px;
  font-weight: 950;
}

.batzo-prize {
  text-align: right;
}

.batzo-prize small,
.batzo-contest-stats small,
.batzo-info-grid small {
  display: block;
  color: #7f8b9a;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .7px;
}

.batzo-prize strong {
  display: block;
  margin-top: 5px;
  color: #20e68a;
  font-size: 17px;
  font-weight: 1000;
}

.batzo-progress {
  height: 5px;
  margin: 17px 0 13px;
  overflow: hidden;
  border-radius: 99px;
  background: rgba(255,255,255,.07);
}

.batzo-progress span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(
    90deg,
    #20e68a,
    #19d9ff,
    #8b5cf6
  );
}

.batzo-contest-stats {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  align-items: center;
  gap: 10px;
}

.batzo-contest-stats strong {
  display: block;
  margin-top: 4px;
  font-size: 11px;
  color: #dfe8f1;
}

.batzo-contest-stats button {
  min-width: 62px;
  border: 0;
  border-radius: 12px;
  padding: 11px 12px;
  background: linear-gradient(100deg, #20e68a, #19d9ff);
  color: #04110b;
  font-size: 13px;
  font-weight: 1000;
}

.batzo-prize-hero {
  position: relative;
  overflow: hidden;
  text-align: center;
  padding: 25px 18px;
  margin-bottom: 14px;
  border-radius: 24px;
  border: 1px solid rgba(32,230,138,.20);
  background:
    radial-gradient(circle at 50% 0%, rgba(32,230,138,.17), transparent 45%),
    linear-gradient(145deg, #111d29, #0c141e);
}

.batzo-prize-hero span {
  display: inline-block;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(139,92,246,.15);
  color: #b99aff;
  font-size: 9px;
  font-weight: 1000;
}

.batzo-prize-hero small {
  display: block;
  margin-top: 15px;
  color: #8794a4;
  font-size: 9px;
  font-weight: 900;
}

.batzo-prize-hero strong {
  display: block;
  margin: 4px 0;
  font-size: 34px;
  font-weight: 1000;
  background: linear-gradient(
    90deg,
    #20e68a,
    #19d9ff,
    #8b5cf6,
    #ff3cac
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.batzo-prize-hero p {
  margin: 0;
  color: #aab5c2;
  font-weight: 800;
}

.batzo-info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
  margin-bottom: 14px;
}

.batzo-info-grid > div {
  padding: 14px 10px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 16px;
  background: rgba(255,255,255,.035);
  text-align: center;
}

.batzo-info-grid strong {
  display: block;
  margin-top: 6px;
  font-size: 14px;
}

.batzo-detail-card {
  padding: 7px 16px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 20px;
  background: rgba(255,255,255,.035);
}

.batzo-detail-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid rgba(255,255,255,.055);
}

.batzo-detail-row:last-child {
  border-bottom: 0;
}

.batzo-detail-row span {
  color: #8995a4;
  font-size: 13px;
}

.batzo-detail-row strong {
  color: #eef5fa;
  font-size: 13px;
}

.batzo-contest-note {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 15px 2px;
  color: #84909e;
}

.batzo-contest-note span {
  color: #20e68a;
  font-size: 18px;
}

.batzo-contest-note p {
  margin: 0;
  font-size: 10px;
  line-height: 1.4;
}

.batzo-join-btn,
.batzo-primary-btn,
.batzo-secondary-btn {
  width: 100%;
  border: 0;
  border-radius: 16px;
  padding: 16px;
  font-size: 14px;
  font-weight: 1000;
}

.batzo-join-btn,
.batzo-primary-btn {
  background: linear-gradient(
    100deg,
    #20e68a,
    #19d9ff
  );
  color: #04110b;
  box-shadow: 0 12px 28px rgba(32,230,138,.18);
}

.batzo-secondary-btn {
  margin-top: 10px;
  background: rgba(255,255,255,.06);
  color: #d7e0e8;
}

.batzo-joined-card {
  text-align: center;
  padding: 28px 18px;
  border-radius: 25px;
  border: 1px solid rgba(32,230,138,.22);
  background:
    radial-gradient(circle at 50% 0%, rgba(32,230,138,.15), transparent 45%),
    linear-gradient(145deg, #111d29, #0c141e);
}

.batzo-success-icon {
  width: 68px;
  height: 68px;
  margin: 0 auto 14px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(32,230,138,.13);
  border: 1px solid rgba(32,230,138,.35);
  color: #20e68a;
  font-size: 36px;
  font-weight: 1000;
}

.batzo-success-label {
  color: #20e68a;
  font-size: 10px;
  font-weight: 1000;
  letter-spacing: 1.5px;
}

.batzo-joined-card h2 {
  margin: 9px 0 5px;
  font-size: 24px;
}

.batzo-joined-card > p {
  margin: 0 0 18px;
  color: #8b98a8;
}

.batzo-team-box {
  display: grid;
  gap: 5px;
  padding: 17px;
  margin-bottom: 18px;
  border-radius: 17px;
  background: rgba(255,255,255,.045);
  border: 1px solid rgba(255,255,255,.07);
}

.batzo-team-box span {
  color: #20e68a;
  font-size: 9px;
  font-weight: 1000;
  letter-spacing: 1px;
}

.batzo-team-box strong {
  font-size: 20px;
}

.batzo-team-box small {
  color: #84909d;
}

.batzo-safe-footer {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-top: 18px;
  padding: 15px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.06);
  background: rgba(255,255,255,.025);
}

.batzo-safe-footer span {
  font-size: 23px;
}

.batzo-safe-footer strong,
.batzo-safe-footer small {
  display: block;
}

.batzo-safe-footer strong {
  font-size: 12px;
}

.batzo-safe-footer small {
  margin-top: 3px;
  color: #7e8a98;
  font-size: 10px;
}

@media (max-width: 600px) {
  .batzo-contest-page {
    padding-left: 13px;
    padding-right: 13px;
  }

  .batzo-contest-card {
    border-radius: 20px;
  }
}

/* ============================================================
   END BATZO PREMIUM CONTEST UI
   ============================================================ */
