    },
    'delhi kings|mumbai tigers': {
      date: 'Today',
      time: 'Live Now',
      venue: 'Batzo Cricket Stadium',
      format: 'T20'
    }
  };

  const k = known[key] || {};

  const dateValue =
    m.date ||
    m.matchDate ||
    m.startDate ||
    m.dateTime ||
    m.startTime ||
    k.date ||
    'Date unavailable';

  const timeValue =
    m.time ||
    m.matchTime ||
    m.startTime ||
    k.time ||
    'Time unavailable';

  const venueValue =
    m.venue ||
    m.stadium ||
    m.ground ||
