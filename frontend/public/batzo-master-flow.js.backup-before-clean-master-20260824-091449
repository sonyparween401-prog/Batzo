      .querySelectorAll('[data-delete]')
      .forEach(btn=>{

        btn.onclick=function(ev){

          if(ev){
            ev.preventDefault();
            ev.stopPropagation();
          }

          const i=
            Number(btn.dataset.delete);

          const a=teams();

          if(!a[i])return;

          if(
            !confirm(
              'Delete Team '+(i+1)+'?'
            )
          ){
            return;
