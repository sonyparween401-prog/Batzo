:root {
  --bg: #030508;
  --panel: #0b1016;
  --panel2: #10161e;
  --text: #f7f8fa;
  --muted: #89919e;
  --line: rgba(255,255,255,.11);
  --green: #20df75;
  --green2: #0dbb5c;
  --purple: #bd3cff;
  --blue: #159bff;
  --pink: #f028c8;
  --gold: #ffbd24;
  --red: #ff3855;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  width: 100%;
}

body {
  background: #030508;
  color: var(--text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
  cursor: pointer;
}

.batzo-app {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 18%, rgba(0,255,135,.045), transparent 26%),
    radial-gradient(circle at 88% 35%, rgba(120,35,255,.045), transparent 30%),
    #030508;
  padding-bottom: 92px;
  overflow-x: hidden;
}

.top-header {
  min-height: 126px;
  padding: 25px 24px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  border-bottom: 1px solid rgba(255,255,255,.055);
  background: rgba(3,5,8,.95);
}

.logo-area {
  min-width: 0;
  padding-top: 8px;
}

.batzo-logo {
  display: flex;
  align-items: center;
  line-height: .75;
  font-size: clamp(47px, 12vw, 76px);
  font-weight: 1000;
  font-style: italic;
  letter-spacing: -6px;
  transform: skewX(-5deg);
  filter: drop-shadow(0 7px 5px rgba(0,0,0,.9));
  white-space: nowrap;
}

.batzo-logo span:nth-child(1) {
  color: #55ff45;
  text-shadow:
    2px 3px 0 #00863b,
    4px 6px 0 #005226,
    0 0 14px rgba(65,255,93,.5);
}

.batzo-logo span:nth-child(2) {
  color: #ffd51c;
  text-shadow:
    2px 3px 0 #d85c00,
    4px 6px 0 #7b2400;
}

.batzo-logo span:nth-child(3) {
  color: #ff2c51;
  text-shadow:
    2px 3px 0 #9d005d,
    4px 6px 0 #52004c;
}

.batzo-logo span:nth-child(4) {
  color: #a72cff;
  text-shadow:
    2px 3px 0 #5023cc,
    4px 6px 0 #261170;
}

.batzo-logo span:nth-child(5) {
  color: #16dfff;
  text-shadow:
    2px 3px 0 #006da5,
    4px 6px 0 #003b69,
    0 0 18px rgba(0,217,255,.4);
}

.logo-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 10px;
}

.logo-line i {
  display: block;
  width: 48px;
  height: 3px;
  border-radius: 4px;
  background: linear-gradient(90deg,#27ed66,#ffd21c,#ff32c8,#20cfff);
}

.logo-line strong {
  font-size: 12px;
  letter-spacing: 4px;
  color: #25ef76;
  white-space: nowrap;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.notification-btn {
  position: relative;
  width: 64px;
  height: 64px;
  flex: 0 0 64px;
  color: white;
  background: linear-gradient(145deg,#0c1118,#070a0e);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 20px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.05);
}

.notification-btn .bell {
  font-size: 29px;
  display: block;
  transform: rotate(180deg);
}

.notification-btn b {
  position: absolute;
  right: 4px;
  top: 2px;
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: white;
  background: #f02d31;
  font-size: 11px;
}

