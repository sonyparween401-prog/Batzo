/* BATZO_FINAL_NAV_CONTROLLER_V2 */
(function(){
  if(window.__BATZO_FINAL_NAV_CONTROLLER_V2__) return;
  window.__BATZO_FINAL_NAV_CONTROLLER_V2__ = true;

  function norm(v){
    return (v || "")
      .replace(/\s+/g," ")
      .trim()
      .toLowerCase();
  }

  function label(el){
    return norm(
      el.getAttribute("aria-label") ||
      el.textContent ||
      ""
    );
  }

  function isBottom(el){
    if(!el) return false;

    const r = el.getBoundingClientRect();

    /* Bottom navigation is physically near the bottom. */
    if(
      window.innerHeight > 0 &&
      r.top > window.innerHeight * 0.70
    ){
      return true;
    }

    const cls = norm(el.className);
    const parent = el.closest(
      "nav,footer,[class*='bottom'],[class*='Bottom'],[class*='navigation'],[class*='Navigation']"
    );

    return !!parent ||
      cls.includes("bottom") ||
      cls.includes("navigation");
  }

  function findBottomButton(kind){
    const all = Array.from(
      document.querySelectorAll("button,a,[role='button']")
    );

    let candidates = [];

    for(const el of all){
      if(!isBottom(el)) continue;

      const t = label(el);

      if(kind === "match"){
        if(
          t === "match" ||
          t === "matches" ||
          t.includes("match")
        ){
          candidates.push(el);
        }
      }

      if(kind === "contest"){
        if(
          t === "contest" ||
          t === "contests" ||
          t.includes("contest")
        ){
          candidates.push(el);
        }
      }

      if(kind === "team"){
        if(
          t === "team" ||
          t === "teams" ||
          t === "my team" ||
          t === "my teams"
        ){
          candidates.push(el);
        }
      }
    }

    return candidates[0] || null;
  }

  function activate(kind){
    const target = findBottomButton(kind);

    if(!target){
      console.error(
        "BATZO NAV: working bottom button not found:",
        kind
      );
      return false;
    }

    target.click();
    return true;
  }

  document.addEventListener("click",function(e){

    const target = e.target.closest(
      "button,a,[role='button']"
    );

    if(!target) return;

    /* NEVER interfere with the working bottom navigation. */
    if(isBottom(target)) return;

    const t = label(target);

    let kind = null;

    /* Upcoming match card button */
    if(
      t.includes("view contests") ||
      t.includes("view contest")
    ){
      kind = "contest";
    }

    /* Top Match */
    else if(
      t === "match" ||
      t === "matches"
    ){
      kind = "match";
    }

    /* Top Contest */
    else if(
      t === "contest" ||
      t === "contests"
    ){
      kind = "contest";
    }

    /* Top My Team */
    else if(
      t === "my team" ||
      t === "my teams" ||
      t === "my team(s)"
    ){
      kind = "team";
    }

    if(!kind) return;

    /*
     * Stop the broken top handler.
     * Then execute the already-working bottom handler.
     */
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    activate(kind);

  },true);
})();


/* BATZO_FINAL_JOIN_CONTROLLER_V1 */
(function(){
  if(window.__BATZO_FINAL_JOIN_CONTROLLER_V1__) return;
  window.__BATZO_FINAL_JOIN_CONTROLLER_V1__=true;

  function getActiveContest(){
    try{
      if(window.BATZO_ACTIVE_CONTEST)
        return window.BATZO_ACTIVE_CONTEST;

      if(typeof window.contest==="function")
        return window.contest();

      const raw=localStorage.getItem(
        "batzo_last_joined_contest"
      );

      if(raw){
        return JSON.parse(raw);
      }
    }catch(err){
      console.error(
        "BATZO ACTIVE CONTEST ERROR:",
        err
      );
    }

    return null;
  }

  function executeJoin(){
    const c=getActiveContest();

    try{
      /*
       * Prefer the final contest flow already present
       * in App.jsx.
       */
      if(typeof window.finalJoinContest==="function"){
        window.finalJoinContest(c);
        return true;
      }

      if(
        window.BATZO_FINAL &&
        typeof window.BATZO_FINAL.joinContest==="function"
      ){
        window.BATZO_FINAL.joinContest(c);
        return true;
      }

      /*
       * Existing project fallback.
       */
      if(typeof window.joinContest==="function"){
        window.joinContest(c);
        return true;
      }

      console.error(
        "BATZO JOIN: no existing join handler exposed"
      );
      return false;

    }catch(err){
      console.error(
        "BATZO JOIN ERROR:",
        err
      );

      try{
        if(
          window.BATZO_FINAL &&
          typeof window.BATZO_FINAL.joinContest==="function"
        ){
          window.BATZO_FINAL.joinContest(c);
          return true;
        }
      }catch(e2){
        console.error(
          "BATZO FINAL JOIN FALLBACK ERROR:",
          e2
        );
      }

      return false;
    }
  }

  document.addEventListener(
    "click",
    function(e){

      const el=e.target.closest(
        "#batzoFinalJoin,#batzoJoinContest," +
        "[data-batzo-join-contest]"
      );

      if(!el) return;

      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();

      /*
       * Prevent accidental double join taps.
       */
      if(el.dataset.batzoJoining==="1") return;

      el.dataset.batzoJoining="1";

      const oldText=el.textContent;

      try{
        el.textContent="JOINING…";
      }catch(_){}

      const ok=executeJoin();

      if(!ok){
        try{
          el.textContent=oldText;
          el.dataset.batzoJoining="0";
        }catch(_){}
      }else{
        /*
         * Give the existing join flow time to render the next
         * screen. If it did not navigate, restore the button.
         */
        setTimeout(function(){
          try{
            if(
              document.body.contains(el) &&
              !el.disabled
            ){
              el.textContent=oldText;
              el.dataset.batzoJoining="0";
            }
          }catch(_){}
        },1800);
      }

    },
    true
  );

  console.log(
    "BATZO FINAL JOIN CONTROLLER READY"
  );
})();

export default App;
