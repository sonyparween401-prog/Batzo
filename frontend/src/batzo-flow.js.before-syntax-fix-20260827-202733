function read(key,fallback){
  try{
    const v=localStorage.getItem(key);
    return v===null?fallback:JSON.parse(v);
  }catch{
    return fallback;
  }
}

function write(key,value){
  try{
    localStorage.setItem(key,JSON.stringify(value));
  }catch{}
}

function playersOf(team){
  return Array.isArray(team?.players)?team.players:[];
}

function esc(v){
  return String(v??"").replace(
    /[&<>"']/g,
    m=>({
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;",
      "'":"&#39;"
    }[m])
  );
}

function counts(players){
  const c={BAT:0,BOWL:0,AR:0,WK:0};

  players.forEach(p=>{
    if(c[p.role]!==undefined){
      c[p.role]++;
    }
  });

  return c;
}

function validate(players){

  if(players.length!==11){
    return "Team must contain exactly 11 players.";
  }

  const c=counts(players);

  if(c.WK<1 || c.WK>4){
    return `Wicket-Keeper: choose 1–4 (currently ${c.WK}).`;
  }

  if(c.BAT<3 || c.BAT>6){
    return `Batter: choose 3–6 (currently ${c.BAT}).`;
  }

  if(c.AR<1 || c.AR>4){
    return `All-Rounder: choose 1–4 (currently ${c.AR}).`;
  }

  if(c.BOWL<3 || c.BOWL>6){
    return `Bowler: choose 3–6 (currently ${c.BOWL}).`;
  }

  const ind=players.filter(p=>p.team==="IND").length;
  const aus=players.filter(p=>p.team==="AUS").length;

  if(ind>7 || aus>7){
    return `Maximum 7 players from one side. IND ${ind} • AUS ${aus}.`;
  }

  const credits=players.reduce(
    (s,p)=>s+Number(p.credit||0),
    0
  );

  if(credits>100){
    return `Credits limit exceeded: ${credits.toFixed(1)}/100.`;
  }

  return "";
}

function roleText(players){
  const c=counts(players);

  return `BAT ${c.BAT}/3–6 • AR ${c.AR}/1–4 • WK ${c.WK}/1–4 • BOWL ${c.BOWL}/3–6`;
}

