function interceptClicks(ev){

  const el=
    ev.target?.closest?.(
      "button,a"
    );

  if(!el)return;

  const id=
    el.id||"";

  const text=
    (
      el.innerText ||
      el.textContent ||
      ""
    )
    .replace(/\s+/g," ")
    .trim()
    .toUpperCase();

  if(
    id==="bzTeamContinue" ||
    id==="bzConfirmTeam" ||
    id==="batzoConfirmFinal" ||
    (
      text.includes("CONTINUE") &&
      document.getElementById("bzPlayers")
    ) ||
    text==="CONFIRM TEAM" ||
    text.includes("CONFIRM TEAM")
  ){

    ev.preventDefault();
    ev.stopPropagation();
    ev.stopImmediatePropagation();

    if(
      typeof el.__batzoCleanHandler===
      "function"
    ){
      el.__batzoCleanHandler();
    }

    return;

  }

  if(
    text.includes("CREATE NEW TEAM") ||
    text.includes("CREATE TEAM") ||
    text.includes("BUILD YOUR XI")
  ){

    ev.preventDefault();
    ev.stopPropagation();
    ev.stopImmediatePropagation();

    renderTeam("IND vs AUS");

    return;

  }

  if(
    text==="MY TEAMS" ||
    text.includes("MY TEAMS")
  ){

    ev.preventDefault();
    ev.stopPropagation();
    ev.stopImmediatePropagation();

    renderMyTeams();

    return;

  }

  if(
    text.includes("JOIN CONTEST") ||
    text==="JOIN NOW"
  ){

    ev.preventDefault();
    ev.stopPropagation();
    ev.stopImmediatePropagation();

    renderTeam("IND vs AUS");

    return;

  }

}

